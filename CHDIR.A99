;===================================================================
; CHDIR.A99 - shell internal command CHDIR                  (shell 6.5)
;
; Assembled on its own at AORG >D000 and loaded at cold start into
; its own physical page of segment D (page 8).  Runs with PSEL on.
;
; Rules for every command page:
;   - exit by branching into the core - RETURN, NEXTCMD or an error
;     exit; never return, never call another command
;   - never execute PSEL_DIS, never remap segment D
;   - the BDOS is reached through the gate: CORE.INC equates BDOS to it,
;     so DECLS.INC must never declare BDOS
;   - the first instruction must be B @entry: LDCMDS checks for it
;   - anything up to 4096 bytes fits; the page is this command's alone
;===================================================================
	INCL	"C:DECLS.INC"	; registers, XOPs, EQUs (hand-maintained)
	INCL	"C:CORE.INC"	; core addresses (generated by MKCINC)
	AORG	0D000H
	B	@DOCHDIR		; entry: every command page starts here

;--- CHDIR ---
DOCHDIR:
	LI	R3,CMDLINE
CHSK1	CB	*R3+,@SPACE
	JH	CHSK1
	DEC	R3
CHSK2	CB	*R3,@CR
	JEQ	CHROOT
	CB	*R3+,@SPACE
	JLE	CHSK2
	DEC	R3
	CALL	@PARSENAME
	JMP	CHDOIT
CHROOT:
	LI	R4,FCB
	LI	R2,11
CHPAD:	MOVB	@SPACE,*R4+
	DEC	R2
	JNE	CHPAD
CHDOIT:
	LI	R2,FCHDIR
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	CHERR_SYS

	LI	R4,CURDIR
	LI	R5,FCB
	LI	R2,11
CHCPY:	MOVB	*R5+,*R4+
	DEC	R2
	JNE	CHCPY
	B	@RETURN

CHERR_SYS:
	MESG	@CHERRMSG
	B	@RETURN

CHERRMSG TEXT	'--Directory not found'
	 BYTE	0DH, 0AH, 0
	 EVEN

	END
