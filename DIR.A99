;===================================================================
; DIR.A99 - shell internal command DIR                  (shell 6.5)
;
; Assembled on its own at AORG >D000 and loaded at cold start into
; its own physical page of segment D (page 2).  Runs with PSEL on.
;
; Rules for every command page:
;   - exit by branching into the core - RETURN, NEXTCMD or an error
;     exit; never return, never call another command
;   - never execute PSEL_DIS, never remap segment D
;   - the BDOS is reached through the gate: CORE.INC equates BDOS to it,
;     so DECLS.INC must never declare BDOS
;   - the first instruction must be B @entry: LDCMDS checks for it
;   - anything up to 4096 bytes fits; the page is this command's alone
;===================================================================
	INCL	"C:DECLS.INC"	; registers, XOPs, EQUs (hand-maintained)
	INCL	"C:CORE.INC"	; core addresses (generated by MKCINC)
	AORG	0D000H
	B	@DSKDIR		; entry: every command page starts here

DSKDIR:	CLR	R0
	MOV	R0,@CCOUNT

	; --- FULLY INITIALIZE FCB FOR SAFE DIRECTORY SEARCH ---
	LI	R4,FCB
	CLR	@CRN(R4)		; Clear Current Record Number
	CLR	@CBN(R4)		; Clear Current Block Number

	; Clear bytes 12 through 35 of FCB to prevent stale pointers
	LI	R2,12
	LI	R5,FCB+12
DSK_CLR: CLR	*R5+
	DECT	R2
	JNE	DSK_CLR

	; --- TELL BDOS TO USE THE ACTIVE FOLDER ---
	MOVB	@SPACE,@FCB+18		; Blank target byte = Use CFLD

	; Populate filename fields (bytes 0-10) with '?' wildcards
	LI	R1,'?'*256
	LI	R0,NAMSIZ
	LI	R8,FCB
	MOV	R8,R2
DSKDIR0	MOVB	R1,*R2+
	DEC	R0
	JNE	DSKDIR0

	; BDOS automatically filters SEARCH1 using its internal active CFLD
	LI	R2,SEARCH1
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	NOFILE
	CALL	@PNAME
DSKDIR1	LI	R2,SEARCH2
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	DIREXIT
	CALL	@PNAME
	JMP	DSKDIR1

PNAME	MOV	R3,R1
	LI	R0,NAMSIZ
PNAME2	DECT	SP
	MOV	R0,*SP
	MOVB	*R1+,R3
	SWPB	R3
	DECT	SP
	MOV	R1,*SP
	LI	R2,COUT
	CALL	@BDOS
	MOV	*SP+,R1
	MOV	*SP+,R0
	DEC	R0
	JNE	PNAME2
	INC	@CCOUNT
	MOV	@CCOUNT,R0
	CI	R0,DIRCOLS
	JLT	PNAMESP
	CLR	R0
	MOV	R0,@CCOUNT
	MESG	@CRLF
	JMP	PNAME3
PNAMESP	MESG	@SEP
PNAME3	RET

DIREXIT	MESG	@CRLF
	CLR	R1
	B	@RETURN
NOFILE	MESG	@MNOFILE
	CLR	R1
	B	@RETURN


	END
