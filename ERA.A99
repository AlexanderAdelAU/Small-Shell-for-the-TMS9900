;===================================================================
; ERA.A99 - shell internal command ERA                  (shell 6.5)
;
; Assembled on its own at AORG >D000 and loaded at cold start into
; its own physical page of segment D (page 4).  Runs with PSEL on.
;
; Rules for every command page:
;   - exit by branching into the core - RETURN, NEXTCMD or an error
;     exit; never return, never call another command
;   - never execute PSEL_DIS, never remap segment D
;   - the BDOS is reached through the gate: CORE.INC equates BDOS to it,
;     so DECLS.INC must never declare BDOS
;   - the first instruction must be B @entry: LDCMDS checks for it
;   - anything up to 4096 bytes fits; the page is this command's alone
;===================================================================
	INCL	"C:DECLS.INC"	; registers, XOPs, EQUs (hand-maintained)
	INCL	"C:CORE.INC"	; core addresses (generated by MKCINC)
	AORG	0D000H
	B	@ERAFILE		; entry: every command page starts here

;===================================================================
; ERA - erase files, with wildcards                       (6.5a)
;
;   ERA NAME.EXT     one file, as before
;   ERA *.A99        every .A99 file in the active folder
;   ERA TEST.*       TEST with any extension;  T*.A99, ?.* etc.
;   ERA *.*          everything in the active folder - asks first
;
; ERA never erases a system file (.SYS or .SHC) - not by wildcard and
; not by full name.  The boot loader needs SHELL.SYS and BDOS.SYS, and
; LDCMDS the .SHC pages; losing one leaves the next boot dead.
; 6.5b: 6.5a still let a full name through, and ERA BDOS.SYS did it.
;
; PARSENAME already turns * into ? fill, and SEARCH1/SEARCH2 already
; match ?, which is how DIR lists everything.  ERA used to do one
; SEARCH1 and one ERAFIL on the pattern, so at most one file went.
;
; Now: collect every matching name into ERABUF first, then erase each
; one by its exact name.  Nothing is erased while a search is open, so
; it does not matter whether ERAFIL disturbs the BDOS search position.
; The BDOS clobbers registers, so all loop state lives in memory words.
;===================================================================
MAXERA	EQU	200			; names per run (11 bytes each)

ERAPERR	B	@PARSMSG

ERAFILE	CLR	@RECCNT
	CLR	@BUFPNT
	LI	R3,TPA
	MOV	R3,@SADDR
	LI	R3,CMDLINE
ERA0	CB	*R3+,@SPACE		; step over the command word
	JH	ERA0
	DEC	R3
ERA01	CB	*R3,@CR			; no file name given?
	JEQ	ERAPERR
	CB	*R3+,@SPACE
	JLE	ERA01
	DEC	R3
	CALL	@PARSENAME		; FCB 0-10 = name, * -> ? fill

	; --- a clean search FCB, as DIR builds: bytes 12-35 cleared,
	;     folder byte 18 kept as PARSENAME set it (active folder)
	MOVB	@FCB+18,@EFOLD
	LI	R5,FCB+12
	LI	R2,12
ECLR	CLR	*R5+
	DEC	R2
	JNE	ECLR
	MOVB	@EFOLD,@FCB+18

	; --- how many ? in the name: 0 = plain name, 11 = *.*
	LI	R1,FCB
	LI	R0,NAMSIZ
	CLR	R2
EWLP	CB	*R1+,@QMARK
	JNE	EWNX
	INC	R2
EWNX	DEC	R0
	JNE	EWLP
	MOV	R2,@EWILD
	CI	R2,NAMSIZ
	JNE	ECOLL

	; --- *.* : ask first
	LI	R1,EALLMSG
	CALL	@PSTR
	LI	R2,CIN
	CALL	@BDOS
	SWPB	R1			; key to the high byte
	MOVB	R1,@EKEY
	MESG	@CRLF
	CB	@EKEY,@YUP
	JEQ	ECOLL
	CB	@EKEY,@YLOW
	JEQ	ECOLL
	B	@EEXIT

	; --- pass 1: collect the matching names into ERABUF
ECOLL	CLR	@ENUM
	CLR	@EMORE
	CLR	@ESKIP
	LI	R0,ERABUF
	MOV	R0,@EPTR
	LI	R2,SEARCH1
ESRCH	LI	R3,FCB
	CALL	@BDOS			; R1 < 0: no (more) matches
	MOV	R1,R1			; else R3 -> the matching name
	JLT	ECDONE
	LI	R4,ESYSTAB		; never .SYS or .SHC, however named
ECH1	MOVB	*R4,R0
	JEQ	ECAP			; end of table: not a system file
	CB	@8(R3),*R4
	JNE	ECH2
	CB	@9(R3),@1(R4)
	JNE	ECH2
	CB	@10(R3),@2(R4)
	JEQ	ESYSF
ECH2	AI	R4,3
	JMP	ECH1
ESYSF	INC	@ESKIP			; leave it, look for the next
	LI	R2,SEARCH2
	JMP	ESRCH
ECAP	MOV	@ENUM,R0
	CI	R0,MAXERA
	JL	ESAVE
	SETO	@EMORE			; buffer full: erase these, say so
	JMP	ECDONE
ESAVE	MOV	@EPTR,R2
	LI	R0,NAMSIZ
ECPY	MOVB	*R3+,*R2+
	DEC	R0
	JNE	ECPY
	MOV	R2,@EPTR
	INC	@ENUM
	LI	R2,SEARCH2
	JMP	ESRCH

ECDONE	MOV	@ENUM,R0
	JNE	EERASE
	MOV	@ESKIP,R0		; nothing to erase: only system
	JNE	EFIN			;   files matched, or none at all
	MESG	@MNOFILE
	B	@EEXIT

	; --- pass 2: erase each collected name exactly
EERASE	LI	R0,ERABUF
	MOV	R0,@EPTR
ELOOP	MOV	@ENUM,R0
	JEQ	EFIN
	MOV	@EPTR,R1		; FCB 0-10 = this name
	LI	R2,FCB
	LI	R0,NAMSIZ
ENAM	MOVB	*R1+,*R2+
	DEC	R0
	JNE	ENAM
	LI	R5,FCB+12		; 12-35 clear, folder byte back
	LI	R2,12
ECLR2	CLR	*R5+
	DEC	R2
	JNE	ECLR2
	MOVB	@EFOLD,@FCB+18
	MOV	@EWILD,R0		; wildcard: show the name
	JEQ	EDEL
	CALL	@PNAM11
EDEL	LI	R2,ERAFIL
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1			; negative = failed.  JLT, not JHE:
	JLT	ENOTE			; MOV sets L> for >FFFF too, so the
	JMP	EOK			; old JHE test took -1 as success
ENOTE	LI	R1,ENOTMSG		; this one would not go
	CALL	@PSTR
	MOV	@EWILD,R0
	JNE	EOK
	MESG	@CRLF			; plain name: end the message line
EOK	MOV	@EWILD,R0
	JEQ	ENEXT
	MESG	@CRLF
ENEXT	MOV	@EPTR,R0
	AI	R0,NAMSIZ
	MOV	R0,@EPTR
	DEC	@ENUM
	JMP	ELOOP

EFIN	MOV	@ESKIP,R0
	JEQ	EFIN2
	LI	R1,ESYSMSG
	CALL	@PSTR
EFIN2	MOV	@EMORE,R0
	JEQ	EEXIT
	LI	R1,EMOREMSG
	CALL	@PSTR
EEXIT	CLR	R1
	B	@RETURN

;--- print the 11-byte name in FCB, as DIR does ---
PNAM11	CLR	@EIDX
PN1	MOV	@EIDX,R1
	MOVB	@FCB(R1),R3
	SWPB	R3			; character to the low byte for COUT
	LI	R2,COUT
	CALL	@BDOS
	INC	@EIDX
	MOV	@EIDX,R1
	CI	R1,NAMSIZ
	JLT	PN1
	RET

;--- print a zero-terminated string from this page (R1 -> it).
;    By BDOS COUT, a character at a time; the pointer lives in memory.
PSTR	MOV	R1,@ESTR
PS1	MOV	@ESTR,R1
	MOVB	*R1,R3
	JEQ	PS2
	INC	@ESTR
	SWPB	R3
	LI	R2,COUT
	CALL	@BDOS
	JMP	PS1
PS2	RET

;--- page data ---
ENUM	WORD	0			; names collected / left to erase
EPTR	WORD	0			; walk pointer into ERABUF
EWILD	WORD	0			; count of ? in the name (0 = plain)
EMORE	WORD	0			; nonzero: more matches than MAXERA
ESKIP	WORD	0			; system files a wildcard left alone
EIDX	WORD	0
ESTR	WORD	0
EFOLD	BYTE	0			; folder byte PARSENAME left in FCB+18
EKEY	BYTE	0
QMARK	BYTE	'?'
YUP	BYTE	'Y'
YLOW	BYTE	'y'
	EVEN
EALLMSG	TEXT	'Erase ALL files in this folder (Y/N)? '
	BYTE	0
ENOTMSG	TEXT	'  --not erased'
	BYTE	0
EMOREMSG TEXT	'--More files match: run ERA again'
	BYTE	0DH,0AH,0
ESYSMSG	TEXT	'--System files (.SYS .SHC) are protected: not erased'
	BYTE	0DH,0AH,0
ESYSTAB	TEXT	'SYSSHC'			; extensions ERA never erases
	BYTE	0
	EVEN

ERABUF	BSS	MAXERA*NAMSIZ		; must end below >E000 - see ERAEND
ERAEND

	END
