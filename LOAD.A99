;===================================================================
; LOAD.A99 - shell internal command LOAD                  (shell 6.5)
;
; Assembled on its own at AORG >D000 and loaded at cold start into
; its own physical page of segment D (page 6).  Runs with PSEL on.
;
; Rules for every command page:
;   - exit by branching into the core - RETURN, NEXTCMD or an error
;     exit; never return, never call another command
;   - never execute PSEL_DIS, never remap segment D
;   - the BDOS is reached through the gate: CORE.INC equates BDOS to it,
;     so DECLS.INC must never declare BDOS
;   - the first instruction must be B @entry: LDCMDS checks for it
;   - anything up to 4096 bytes fits; the page is this command's alone
;===================================================================
	INCL	"C:DECLS.INC"	; registers, XOPs, EQUs (hand-maintained)
	INCL	"C:CORE.INC"	; core addresses (generated by MKCINC)
	AORG	0D000H
	B	@DOLOAD		; entry: every command page starts here

;--- LOAD OVERLAY ---
DOLOAD:
	LI	R3,CMDLINE
DLSK1	CB	*R3+,@SPACE
	JH	DLSK1
	DEC	R3
DLSK2	CB	*R3,@CR
	JNE	DLSK_E
	B	@DLERR
DLSK_E	CB	*R3+,@SPACE
	JLE	DLSK2
	DEC	R3
	CALL	@PARSENAME
	LI	R4,FCB
	CLR	@CRN(R4)
	LI	R2,FOPEN
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JHE	DLSK_F
	B	@DLERR
DLSK_F
	LI	R3,STAGING
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JNE	DLSK_G
	B	@DLERR
DLSK_G
	LI	R6,STAGING
	LI	R8,STAGING+512
DLBLK:
	MOV	R6,R7
	MOV	*R6+,R5
	MOV	*R6+,R4
	MOV	*R6+,R2
	MOV	*R6+,R3
	MESG	@LD_BLK
	MOV	R4,R0
	WHEX	R0
	MESG	@LD_SEP
	MOV	R2,R0
	WHEX	R0
	MESG	@LD_SEP
	MOV	R3,R0
	WHEX	R0
	MESG	@LD_NL
	; 6.5: refuse a block at or above >C000, as the EXE loader does.
	; Here it matters twice over: this code runs from segment D, so a
	; block remapping D would pull LOAD out from under itself.
	CI	R2,0C000H
	JHE	DLPROT
	MOV	R2,R9
	A	R3,R9			; R9 = first address past the block
	JOC	DLPROT			; wrapped past >FFFF
	CI	R9,0C000H
	JLE	DLBOK
DLPROT	MESG	@DLTXT_PROT
	B	@NEXTCMD
DLBOK	MOV	R4,R0
	JEQ	DLCPY_S
	MOV	R2,R9
	SRL	R9,12
	BL	@MAP_SET
DLCPY_S:	; 6.5: PSEL_EN removed - redundant, the dispatcher
	; runs this page with PSEL already on
	SRL	R3,1
DLCPY:
	MOV	*R6+,*R2+
	DEC	R3
	JEQ	DLDONE_B
	C	R6,R8
	JL	DLCPY
	; 6.5: PSEL_DIS removed - it would unmap the page this
	; code runs from.  BDOS calls go through the gate instead.
	DECT	SP
	MOV	R7,*SP
	DECT	SP
	MOV	R5,*SP
	DECT	SP
	MOV	R3,*SP
	DECT	SP
	MOV	R2,*SP
	LI	R3,STAGING
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	MOV	*SP+,R2
	MOV	*SP+,R3
	MOV	*SP+,R5
	MOV	*SP+,R7
	CI	R1,-1
	JEQ	DLDONE_B
	; 6.5: PSEL_EN removed - redundant, the dispatcher
	; runs this page with PSEL already on
	LI	R6,STAGING
	LI	R8,STAGING+512
	JMP	DLCPY
DLDONE_B:
	; 6.5: PSEL_DIS removed - it would unmap the page this
	; code runs from.  BDOS calls go through the gate instead.
	MOV	R5,R5
	JEQ	DLDONE
	A	R5,R7
	MOV	R7,R6
	C	R6,R8
	JL	DLBLK
	S	R8,R6
	DECT	SP
	MOV	R5,*SP
	DECT	SP
	MOV	R6,*SP
	LI	R3,STAGING
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	MOV	*SP+,R6
	MOV	*SP+,R5
	LI	R8,STAGING+512
	AI	R6,STAGING
	JMP	DLBLK
DLDONE:	MESG	@DLTXT_OK
	B	@NEXTCMD
DLERR	MESG	@DLTXT_ERR
	B	@NEXTCMD

DLTXT_OK	TEXT	'Loaded as overlay '
	BYTE	0
	EVEN
DLTXT_CRLF	BYTE	0DH,0AH,0
	EVEN
DLTXT_ERR	TEXT	'--Load error'
	BYTE	0DH,0AH,0
	EVEN


; LOAD's own copies of the core's debug strings, which live in D0.
LD_BLK	TEXT	'BLK PG:'
	BYTE	0
	EVEN
LD_SEP	TEXT	' '
	BYTE	0
	EVEN
LD_NL	BYTE	0DH,0AH,0
	EVEN
DLTXT_PROT TEXT	'--EXE block overlaps shell memory'
	BYTE	0DH,0AH,0
	EVEN

	END
