;===================================================================
; REN.A99 - shell internal command REN                  (shell 6.5)
;
; Assembled on its own at AORG >D000 and loaded at cold start into
; its own physical page of segment D (page 10).  Runs with PSEL on.
;
; Rules for every command page:
;   - exit by branching into the core - RETURN, NEXTCMD or an error
;     exit; never return, never call another command
;   - never execute PSEL_DIS, never remap segment D
;   - the BDOS is reached through the gate: CORE.INC equates BDOS to it,
;     so DECLS.INC must never declare BDOS
;   - the first instruction must be B @entry: LDCMDS checks for it
;   - anything up to 4096 bytes fits; the page is this command's alone
;===================================================================
	INCL	"C:DECLS.INC"	; registers, XOPs, EQUs (hand-maintained)
	INCL	"C:CORE.INC"	; core addresses (generated by MKCINC)
	AORG	0D000H
	B	@DOREN		; entry: every command page starts here

;--- RENAME ---
DOREN:
	LI	R3,CMDLINE
RNSK1	CB	*R3+,@SPACE		; step over the command word
	JH	RNSK1
	DEC	R3
RNSK2	CB	*R3,@CR			; no old name?
	JEQ	RNERR_SYN
	CB	*R3+,@SPACE
	JLE	RNSK2
	DEC	R3
	CALL	@PARSENAME		; old name -> FCB+0
	CALL	@SYSCHK			; 6.5b: never rename a .SYS/.SHC away,
	MOV	@SYSFLG,R0		;   and no wildcards
	JEQ	RNOK1
	B	@SYSREF
RNOK1

	LI	R1,FCB			; park it
	LI	R2,RNBUF
	LI	R0,NAMSIZ
RNSAVE	MOVB	*R1+,*R2+
	DEC	R0
	JNE	RNSAVE

RNSK3	CB	*R3,@CR			; no new name?
	JEQ	RNERR_SYN
	CB	*R3+,@SPACE
	JLE	RNSK3
	DEC	R3
	CALL	@PARSENAME		; new name -> FCB+0
	CALL	@SYSCHK			; 6.5b: nor make a .SYS/.SHC
	MOV	@SYSFLG,R0
	JEQ	RNOK2
	B	@SYSREF
RNOK2

	; Check the new name is free WHILE IT IS STILL AT FCB+0
	LI	R2,SEARCH1
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	RNFREE			; -1 = no match, the name is free
	JMP	RNERR_DUP
RNFREE

	LI	R1,FCB			; new name -> where the BDOS wants it
	LI	R2,FCB+18
	LI	R0,NAMSIZ
RNMOVE	MOVB	*R1+,*R2+
	DEC	R0
	JNE	RNMOVE

	LI	R1,RNBUF		; old name back to FCB+0
	LI	R2,FCB
	LI	R0,NAMSIZ
RNREST	MOVB	*R1+,*R2+
	DEC	R0
	JNE	RNREST

	LI	R2,FRENAM
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	RNERR_NF
	B	@RETURN

RNERR_SYN:
	B	@PARSMSG
RNERR_DUP:
	MESG	@RNDUPMSG
	B	@RETURN
RNERR_NF:
	MESG	@RNNFMSG
	B	@RETURN

RNDUPMSG	BYTE	0DH,0AH
	TEXT	'?Name already in use'
	BYTE	0DH,0AH,0
	EVEN
RNNFMSG	BYTE	0DH,0AH
	TEXT	'?File not found'
	BYTE	0DH,0AH,0
	EVEN



;--- SYSCHK - is the name at FCB+0 one this command must not touch?
;    SYSFLG = 0 ok, 1 = a system file (.SYS .SHC), 2 = a wildcard.
;    Uses R0 and R4 only: the caller's R3 (its place in the command
;    line) must survive.
SYSCHK	CLR	@SYSFLG
	LI	R4,FCB			; any ? in the 11 name bytes?
	LI	R0,NAMSIZ
SYW1	CB	*R4+,@SYQM
	JEQ	SYWILD
	DEC	R0
	JNE	SYW1
	LI	R4,SYSTAB		; extension SYS or SHC?
SYC1	MOVB	*R4,R0
	JEQ	SYC3			; end of table: fine
	CB	@FCB+8,*R4
	JNE	SYC2
	CB	@FCB+9,@1(R4)
	JNE	SYC2
	CB	@FCB+10,@2(R4)
	JNE	SYC2
	LI	R0,1
	MOV	R0,@SYSFLG
	JMP	SYC3
SYC2	AI	R4,3
	JMP	SYC1
SYWILD	LI	R0,2
	MOV	R0,@SYSFLG
SYC3	RET

;--- SYSREF - report a refused name (SYSFLG 1 or 2) and go to the prompt
SYSREF	LI	R1,SYSMSG
	MOV	@SYSFLG,R0
	DEC	R0
	JEQ	SYR1
	LI	R1,WLDMSG
SYR1	CALL	@PSTR
	CLR	R1
	B	@RETURN

;--- print a zero-terminated string from this page (R1 -> it), by BDOS
;    COUT a character at a time; the pointer lives in memory.
PSTR	MOV	R1,@PSPTR
PS1	MOV	@PSPTR,R1
	MOVB	*R1,R3
	JEQ	PS2
	INC	@PSPTR
	SWPB	R3
	LI	R2,COUT
	CALL	@BDOS
	JMP	PS1
PS2	RET

SYSFLG	WORD	0
PSPTR	WORD	0
SYQM	BYTE	'?'
	EVEN
SYSTAB	TEXT	'SYSSHC'		; never written, erased or renamed
	BYTE	0
	EVEN
SYSMSG	TEXT	'--System files (.SYS .SHC) are protected: not renamed'
	BYTE	0DH,0AH,0
WLDMSG	TEXT	'--REN needs exact names, no wildcards'
	BYTE	0DH,0AH,0
	EVEN

	END
