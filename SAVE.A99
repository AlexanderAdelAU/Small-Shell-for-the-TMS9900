;===================================================================
; SAVE.A99 - shell internal command SAVE                  (shell 6.5)
;
; Assembled on its own at AORG >D000 and loaded at cold start into
; its own physical page of segment D (page 3).  Runs with PSEL on.
;
; Rules for every command page:
;   - exit by branching into the core - RETURN, NEXTCMD or an error
;     exit; never return, never call another command
;   - never execute PSEL_DIS, never remap segment D
;   - the BDOS is reached through the gate: CORE.INC equates BDOS to it,
;     so DECLS.INC must never declare BDOS
;   - the first instruction must be B @entry: LDCMDS checks for it
;   - anything up to 4096 bytes fits; the page is this command's alone
;===================================================================
	INCL	"C:DECLS.INC"	; registers, XOPs, EQUs (hand-maintained)
	INCL	"C:CORE.INC"	; core addresses (generated by MKCINC)
	AORG	0D000H
	B	@DSKSAVE		; entry: every command page starts here

;--- SAVE ---
CMDPTR	EQU	0A0H
PARSERR	B	@PARSMSG

DSKSAVE:	CLR	@BUFPNT
	CLR	@RECCNT
	LI	R3,TPA
	MOV	R3,@SADDR
	LI	R3,CMDLINE
START00	CB	*R3+,@SPACE
	JH	START00
	DEC	R3
START02	CB	*R3,@CR
	JEQ	PARSERR
	CB	*R3+,@SPACE
	JLE	START02
	DEC	R3
	MOV	R3,@BUFPNT
	CALL	@ATOD
	MOV	R1,R1
	JEQ	PARSERR
	MOV	R1,@RECCNT
	MOV	@BUFPNT,R3
PREPARSE	CB	*R3,@CR
	JEQ	PARSERR
	CB	*R3+,@SPACE
	JLE	PREPARSE
	DEC	R3
	CALL	@PARSENAME
	CALL	@SYSCHK			; 6.5b: never a .SYS/.SHC, never a
	MOV	@SYSFLG,R0		;   wildcard - NAM3 erases the first
	JEQ	NAM2			;   match before writing
	B	@SYSREF
NAM2	CB	*R3+,@SPACE
	JEQ	NAM2
	DEC	R3
	CB	*R3,@CR
	JEQ	NAMSRCH
	CB	*R3+,@SWITCH
	JNE	PARSERR
	MOV	R3,@BUFPNT
	CALL	@CATOH
	MOV	R1,R1
	JEQ	PARSERR
	MOV	R1,@SADDR
NAMSRCH	LI	R2,SEARCH1
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	NAM5
NAM3	LI	R2,ERAFIL
	LI	R3,FCB
	CALL	@BDOS
NAM5	LI	R2,MAKFIL
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1			; 6.5b: JLT, not JHE - MOV sets L>
	JLT	MKFAIL			;   for >FFFF, so JHE took -1 as success
	JMP	SKMK1
MKFAIL	B	@MKERR
SKMK1:
	LI	R4,FCB
	MOV	@SADDR,R3
	MOV	R3,@FLA(R4)
	CLR	@CRN(R4)
WRDATA	DECT	SP
	MOV	R3,*SP
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,WRSEQ
	LI	R3,FCB
	CALL	@BDOS
	MOV	*SP+,R3
	MOV	R1,R1			; 6.5b: JLT, as above
	JLT	WRFAIL
	JMP	SKWR1
WRFAIL	B	@WRITERR
SKWR1:
	C	R3,@MEMLIMIT
	JL	SKLG1
	B	@LARGERR
SKLG1:
	AI	R3,BYTSEC
	DEC	@RECCNT
	JNE	WRDATA
WRDATAC	LI	R2,FCLOSE
	LI	R3,FCB
	CALL	@BDOS
EXIT	CLR	R1
	B	@RETURN



;--- SYSCHK - is the name at FCB+0 one this command must not touch?
;    SYSFLG = 0 ok, 1 = a system file (.SYS .SHC), 2 = a wildcard.
;    Uses R0 and R4 only: the caller's R3 (its place in the command
;    line) must survive.
SYSCHK	CLR	@SYSFLG
	LI	R4,FCB			; any ? in the 11 name bytes?
	LI	R0,NAMSIZ
SYW1	CB	*R4+,@SYQM
	JEQ	SYWILD
	DEC	R0
	JNE	SYW1
	LI	R4,SYSTAB		; extension SYS or SHC?
SYC1	MOVB	*R4,R0
	JEQ	SYC3			; end of table: fine
	CB	@FCB+8,*R4
	JNE	SYC2
	CB	@FCB+9,@1(R4)
	JNE	SYC2
	CB	@FCB+10,@2(R4)
	JNE	SYC2
	LI	R0,1
	MOV	R0,@SYSFLG
	JMP	SYC3
SYC2	AI	R4,3
	JMP	SYC1
SYWILD	LI	R0,2
	MOV	R0,@SYSFLG
SYC3	RET

;--- SYSREF - report a refused name (SYSFLG 1 or 2) and go to the prompt
SYSREF	LI	R1,SYSMSG
	MOV	@SYSFLG,R0
	DEC	R0
	JEQ	SYR1
	LI	R1,WLDMSG
SYR1	CALL	@PSTR
	CLR	R1
	B	@RETURN

;--- print a zero-terminated string from this page (R1 -> it), by BDOS
;    COUT a character at a time; the pointer lives in memory.
PSTR	MOV	R1,@PSPTR
PS1	MOV	@PSPTR,R1
	MOVB	*R1,R3
	JEQ	PS2
	INC	@PSPTR
	SWPB	R3
	LI	R2,COUT
	CALL	@BDOS
	JMP	PS1
PS2	RET

SYSFLG	WORD	0
PSPTR	WORD	0
SYQM	BYTE	'?'
	EVEN
SYSTAB	TEXT	'SYSSHC'		; never written, erased or renamed
	BYTE	0
	EVEN
SYSMSG	TEXT	'--System files (.SYS .SHC) are protected: not saved'
	BYTE	0DH,0AH,0
WLDMSG	TEXT	'--SAVE needs one exact file name, no wildcards'
	BYTE	0DH,0AH,0
	EVEN

	END
