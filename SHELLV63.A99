;
;*******************************************************************
;
;  TMS99105 SBC V4 - Memory Map
;
;  Address   Label      Purpose
;  >0230     SH_WP      Shell Workspace: R0-R15
;  >0250     SH_CMD     Command Line: raw input string
;  >0280     CM_FCB     FCB (36 bytes)
;  >02A4     CM_VARS    Bridge Variables: pointers, status flags
;  >0300     CM_BUF     512-byte Sector Buffer / LOADERCODE area
;
;  Paged Memory Model (Rev 24Q hardware):
;  Segment 0  (>0000->0FFF) COMMON - forced physical page 0
;  Segments 1-E (>1000->EFFF) PAGED - selected by 6116 map registers
;  Segment F  (>F000->FFFF) ROM - forced physical page 0
;
;  6116 mapper programmed via CRU (LDCR/STCR) at MAP_WIN_BASE.
;  PSEL XOPs enable/disable the GAL page-select output.
;
;  V6.3 raw-COM contract:
;    C and D run on physical page 1 while the application executes.
;    Application BDOS calls pass through a COMMON gateway which disables
;    PSEL for the complete BDOS call, then restores PSEL before RET.
;
;  V6.3 command lookup and procedure contract:
;    A bare command name resolves through EXEC_TAB (COM, EXE, PRO) in
;    precedence order.  An explicitly typed extension is used as typed.
;    File type comes from the directory entry (FTY, FCB offset 11), not
;    from the extension.
;    FTY = PRO is INTERPRETED, not loaded - see PROCEDURE processing.
;
;*******************************************************************
;
;  Original Version:
;  Small/Shell 1.0 - A command processor for North Star DOS
;  Copyright 1981 J.E. Hendrix, All rights reserved
;  Written for PDS assembler
;
;  TMS9900 Port and Modern Revisions:
;
;  4.0   Initial TMS9900 version
;  4.1   Filename extension handling (4 June 2010)
;  4.6   Internal commands: DIR, SAVE, ERA
;  4.7   Multisegment alignment; RETURN changed to RETF
;  4.9   Intermediate paging work
;
;  5.4   Paged memory loader - first working version
;        Transparent GAL mapping - no trampolines, no LDS/LDD
;        LOADERCODE replaced with link99 v3.9 page map loader
;        Sentinel detection: FFFF FFFF FFFF at file offset 6
;        COM/EXE go direct to LOADERCODE (no pre-read)
;        MAP_INIT called at shell entry and LOADERCODE entry
;        .FILENAME load-only restored (reads flat, returns to prompt)
;        R8 saves launch address across LDRCPY walk
;        LDRRUN_F for raw/flat binaries
;
;  5.5   Paged memory loader - production version (June 2026)
;  5.8   Fix EXE reload: read two sectors on staging overflow to match
;        initial load. One-sector reload caused page 3 data corruption
;        for EXE files larger than two sectors (> 1024 bytes).
;        MAP_SET/MAP_INIT getter-setter pattern established
;        LDRSEG calls MAP_SET - no inline CRU bit manipulation
;        R8 saved in LDRPM before MAP_SET clobbers R9
;  6.3   Raw COM C/D private-page execution.
;        COMMON >02E8 launch gate: PSEL_EN / B *R8.
;        COMMON >02F0 return gate: PSEL_DIS / B @RETURN.
;        COMMON >02F6 BDOS gate: PSEL_DIS / CALL @BDOS / PSEL_EN / RET.
;        RETURN explicitly restores C=0,D=0 before MAP_INIT.
;        Proven with repeated XMODEM and R99 TEST H- through full return.
;
;        Command lookup rewritten (September 2026).  A bare name used to
;        get extension '???', so SEARCH1 returned the first directory
;        entry of that name whatever its type - typing HELLO ran
;        HELLO.R99 instead of HELLO.COM and branched into an object
;        file.  LOOK now walks EXEC_TAB.  The retry loop it replaces was
;        already written for a table walk but was reading address >3F00.
;        File type read from FCB+FTY at L_FOUND.  SET_FTY retained but
;        unused: its codes are positional over EXT_TAB (BAS=3, BAT=4)
;        and disagree with the BDOS (TXT=3, BAS=4, PRO=5).
;
;        Procedure processing connected.  DOPROC had never been called
;        from anywhere, so PROCSW was never set, NEXTCMD always chose
;        PROMPT and the whole PFETCH engine was unreachable.
;        MNAM widened to a full 36-byte FCB save area - it was 14 bytes
;        with a 16-byte copy written into it, spilling FSZ over MFTY.
;        PFETCH restores the FCB from MNAM before each record read and
;        saves the advanced cursor back afterwards, because every
;        command a procedure runs reuses FCB at >0280.
;        PRECS added: the engine's own record countdown.  MFSZ cannot
;        serve, L_FOUND rewrites it for every command a procedure runs.
;        DOPROC clears CRN, as LOAD does before its first RDSEQ.
;
;  6.1a  DBG_LOG 80->144 records (1152 bytes): 96-block EXE (M31)
;        overflowed the 80-record log into shell variables and the
;        trace separator strings. 144 = provable max (64K/504+margin).
;        DUMP_EXE_TRACE clamps to 144. Loader code path unchanged.
;  6.0   LDRHDR_RL: save/restore R0 (page) and R2 (start) across its
;        own BDOS calls -- both were live, already-decoded header
;        fields when called from LDRB2/LDRB3, but neither was
;        preserved before.
;        LDRCHAIN_E: between-block sector fetch now checks both
;        reads for real EOF instead of always assuming 2 full
;        sectors are valid -- was reading stale/garbage bytes as a
;        header when a file's true end landed inside this fetch.
;        Multi-sector loading: LDRSEC direct DMA to paged memory
;        BDOS passes DMA address unchanged through page mapper
;        INT2_HANDLER: full debug dump (PC/WP/ST + map registers)
;        INT2_VEC installed before every paged launch
;        Paged execution confirmed: HELLO runs from seg 2 page 2
;        Transparent memory model: XOPs safe from paged code
;        Segment 0 COMMON always page 0 - workspace always visible
;
;*******************************************************************

R0	EQU	0
R1	EQU	1
R2	EQU	2
R3	EQU	3
R4	EQU	4
R5	EQU	5
R6	EQU	6
R7	EQU	7
R8	EQU	8
R9	EQU	9
;R10	EQU	10
R11	EQU	11
R12	EQU	12
WP	EQU	13
R13	EQU	13
R14	EQU	14
R15	EQU	15
SP	EQU	10
;
;----Define  Extended Operations
;
	DXOP	PSEL_DIS, 0
	DXOP	PSEL_EN, 1
;	DXOP	PUSHREG,4
;	DXOP	POPREG,5
	DXOP	CALL,6
	DXOP	RET,7
	DXOP	PUSH,8
	DXOP	POP,9
	DXOP	WHEX,10			;WRITE OUT A 16 BIT HEX VALUE
	DXOP	RHEX,11			;READ IN A 16 BIT HEX VALUE
	DXOP	WRITE,12		;WRITE CHAR IN MSB
	DXOP	READ,13			;READ CHAR IN MSB
	DXOP	MESG,14			;OUTPUT NULL TERMINATED MESSAGE
	DXOP	DEBUG,15
;
; OPERATING SYSTEM EQUATES
;
SHELL:	EQU	0C000H
BDOS:	EQU	0E000H
MONITOR:	EQU	0F000H
BANNER:	EQU	MONITOR + 4

MAP_WIN_BASE:	 EQU	080C0H		;6116 MAP REGISTER CRU BASE
NUM_MAP_ENTRIES: EQU	16		;16 PAGE REGISTERS

;
; WORKSPACE AND MEMORY LAYOUT
;
WORKSP:	EQU	0230H		;SHELL WORKSPACE
STACKP:	EQU	0FFEH		;STACK AT 0x1000, GROWS DOWN
TPA:	EQU	0500H		;DEFAULT LOAD ADDRESS
CMDLINE:	EQU	0250H
HALT:	EQU	10FFH
COMM_BUF:	EQU	0300H		;COMMON BUFFER / LOADERCODE AREA
COMM_FCB:	EQU	0280H
FCB:	EQU	COMM_FCB
;
; SHELL ENTRY POINT
;


	AORG	SHELL
	LWPI	WORKSP

	LI	SP,STACKP
	BL	@MAP_INIT		;CLEAR ALL MAP REGISTERS TO PAGE 0
	B	@INIT
;
; LOW MEMORY EQUATES
;
CMDL_PTR:	EQU	0A0H
CMDL_SIZE:	EQU	0A2H
BUFF_PTR:	EQU	0A4H
LBA:		EQU	0A8H
FCB_PTR:	EQU	0ACH
FREEMEM:	EQU	0A6H
MEMLIMIT:	EQU	0B0H
BUFFSIZ:	EQU	512
;
SHELL_PTR:	EQU	80H
BDOS_PTR:	EQU	84H
LOADER:		EQU	0300H
CLSZ:		EQU	64
BYTSEC:		EQU	512
BYTEWIDE:	EQU	2			;BYTE-PARALLEL CRU TRANSFER WIDTH
NUM_SEGS:	EQU	16			;NUMBER OF MAP SEGMENTS
PROT_SEG:	EQU	12			;FIRST PROTECTED SEGMENT
SEG_SIZE:	EQU	1000H			;4KB SEGMENT SIZE
;PSEL_EN:	EQU	0100H			;PSEL ENABLE VALUE
INT2_VEC:	EQU	000AH			;INT2 VECTOR ADDRESS
;BDOS_PAGE:	EQU	14			;PHYSICAL PAGE WHERE BDOS LIVES
;BDOS_SEG:	EQU	14			;VIRTUAL SEGMENT FOR BDOS (0xE000)
;BDOS_VIRT:	EQU	0E000H			;BDOS VIRTUAL ADDRESS (UNCHANGED)
;BDOS_CRU:	EQU	MAP_WIN_BASE+(BDOS_SEG*2)		;CRU ADDR FOR SEG 14 = 0x80DC
;XOP0_WP:	EQU	0040H			;XOP 0 VECTOR - WORKSPACE PTR
;XOP0_PC:	EQU	0042H			;XOP 0 VECTOR - HANDLER PC
;BDOS_XWP:	EQU	0100H			;BDOS XOP WORKSPACE (32 BYTES)
;BDOS_XOP_E:	EQU	0120H			;BDOS XOP HANDLER ENTRY
STAGING:	EQU	0500H			;SECTOR STAGING BUFFER
;--- OVERLAY MANAGER PAGE VARIABLES (0x02A0-0x02FF) ---
OVL_PRINT_VEC:	EQU	02A0H			;WORD: PRINT CALLBACK ADDRESS
OVL_COUNT:	EQU	02A2H			;WORD: NUMBER OF OVERLAYS LOADED
OVL_PAGE_TAB:	EQU	02A4H			;16 WORDS: PHYSICAL PAGE FOR OVERLAY ID 1-16
OVL_SEG_TAB:	EQU	02C4H			;16 WORDS: VIRTUAL SEGMENT FOR OVERLAY ID 1-16
OVL_CURR_ID:	EQU	02E4H			;WORD: CURRENTLY MAPPED OVERLAY ID (0=NONE)
OVL_CURR_SEG:	EQU	02E6H			;WORD: CURRENTLY MAPPED SEGMENT
FLATBASE:	EQU	1000H			;DEFAULT FLAT LOAD ADDRESS
LGATE:		EQU	02E8H			;COM launch gate (4 bytes)
RGATE:		EQU	02F0H			;COM return gate (6 bytes)
BGATE:		EQU	02F6H			;application BDOS gate (10 bytes)
APAGE:		EQU	1			;private COM physical page
SEGC:		EQU	12			;logical segment C
SEGD:		EQU	13			;logical segment D

IDE_BYTSEC:	EQU	256

;
; BDOS FUNCTION CODES
;
CIN	EQU	1
COUT	EQU	2
SELDSK	EQU	14
RDSEQ	EQU	20
FOPEN	EQU	15
FCLOSE	EQU	16
SEARCH1	EQU	17
SEARCH2	EQU	18
ERAFIL	EQU	19
WRSEQ	EQU	21
MAKFIL	EQU	22
SETDMA	EQU	26
HDERR	EQU	0
DOSERR	EQU	0
;
; FCB OFFSETS
;
FCBSIZ	EQU	36
NAM	EQU	0
FTY	EQU	11
FLA	EQU	16
CRN	EQU	26
CBN	EQU	24
RELB	EQU	28
RELR	EQU	30
FSB	EQU	12
FSZ	EQU	14
;
; FILE TYPES
;
SYS	EQU	0
COM	EQU	1
EXE	EQU	2
TXT	EQU	3
BAS	EQU	4
PRO	EQU	5
;
; ASSEMBLY CONSTANTS
;
BLKSIZ	EQU	512
NAMSIZ	EQU	11
EXTSIZ	EQU	3
DDEN	EQU	1
DCOMR	EQU	1
PAD	EQU	0
EXTOFF	EQU	NAMSIZ-EXTSIZ
CTLC	BYTE	03H
CTLX	BYTE	18H
CTLS	BYTE	13H
CTLY	BYTE	19H
CTLZ	BYTE	1AH
SPACE	BYTE	20H
	BYTE	0
BS	BYTE	08H
CR	BYTE	0DH
LF	BYTE	0AH
DEL	BYTE	07H
EOF	BYTE	0FFH
CPMEOF	BYTE	01AH			; ^Z - what fills the tail of the last record
COMT	BYTE	3AH
JUMP	BYTE	'.'
NULPARM	BYTE	'.'
EXT	BYTE	'.'
NOTE	BYTE	'_'
PROM	BYTE	'%'
SUBMARK	BYTE	'$'
SYSFILE	BYTE	'*'
DOSCMD	BYTE	'+'
CONSOLE	EQU	0
DEFDRV	EQU	0
	EVEN

;*******************************************************************
;	INIT - cold start initialisation
;*******************************************************************
	EVEN
INIT	LWPI	WORKSP
	LI	SP,STACKP

	;--- INIT 7 INTERRUPT VECTORS TO SAFE RTWP HANDLER ---
	LI	R0,WORKSP		;WP FOR INTERRUPT HANDLER
;	LI	R1,INT_SAFE		;PC = SAFE RTWP HANDLER
;	LI	R2,00B0H		;FIRST INTERRUPT VECTOR
;	LI	R3,7			;7 VECTORS
;INIT_IV	MOV	R0,*R2+			;STORE WP
;	MOV	R1,*R2+			;STORE PC
;	DEC	R3
;	JNE	INIT_IV

	;--- INIT OVERLAY MANAGER VARIABLES ---
	CLR	R0
	MOV	R0,@OVL_COUNT
	MOV	R0,@OVL_CURR_ID
	MOV	R0,@OVL_CURR_SEG

	LI	R1,CMDLINE
	LI	R2,CMDLINE2
CMDLOOP:	MOVB	*R2+,*R1+
	JNE	CMDLOOP

	MOVB	@CR,@CMDLINE
	LI	R0,CMDLINE
	MOV	R0,@CMDL_PTR
	CLR	@CMDL_SIZE
	LI	R0,COMM_BUF
	MOV	R0,@BUFF_PTR
	LI	R0,COMM_FCB
	MOV	R0,@FCB_PTR
;
;
;
; INSTALL THE GATEWAYS
;>02E8  launch gate
;        PSEL_EN
;        B *R8
;
;>02F0  return gate
;        PSEL_DIS
;        B @RETURN
;
;>02F6  BDOS gateway
;        PSEL_DIS
;        CALL @BDOS
;        PSEL_EN
;        RET
INIT22
	; Install the mapped-COM launch gate at COMMON >02E8.
	LI	R1,LSRC
	LI	R2,LGATE
LGCP:	MOV	*R1+,*R2+
	CI	R1,LEND
	JL	LGCP

	; Install the mapped-COM return gate at COMMON >02F0.
	LI	R1,RSRC
	LI	R2,RGATE
RGCP:	MOV	*R1+,*R2+
	CI	R1,REND
	JL	RGCP

	; Install the application BDOS gate at COMMON >02F6.
	LI	R1,BSRC
	LI	R2,BGATE
BGCP:	MOV	*R1+,*R2+
	CI	R1,BEND
	JL	BGCP

	; SHELL_PTR: B @RGATE
	LI	R0,0460H
	LI	R1,RGATE
	MOV	R0,@SHELL_PTR
	MOV	R1,@SHELL_PTR+2

	; BDOS_PTR: B @BGATE
	LI	R0,0460H
	LI	R1,BGATE
	MOV	R0,@BDOS_PTR
	MOV	R1,@BDOS_PTR+2

	LI	R0,TPA
	MOV	R0,@FREEMEM
	LI	R0,SHELL
	MOV	R0,@MEMLIMIT

	MESG	@SINON

;*******************************************************************
;	DOCMD - process next shell command
;*******************************************************************
DOCMD	MOV	@SKIPSW,R0
	CLR	@SKIPSW
	MOV	R0,R0
	JNE	DOCMD2A
	LI	R3,CMDLINE
	CLR	R1
	MOVB	*R3,R1
	CB	R1,@CR
	JEQ	DOCMD2A

CHKSYS	CI	R1,0
	JNE	DOCMD1
	B	@CMDERR

DOCMD1	CB	R1,@CTLX
	JNE	DOCMDAA
	BLWP	@BANNER
DOCMDAA	CB	R1,@CTLY
	JNE	DOCMD2

DOCMD2	CB	R1,@SPACE
	JH	DOCMD4

DOCMD2A	B	@NEXTCMD

DOCMD4	CB	R1,@JUMP
	JNE	DOCMD3
	LI	R3,CMDLINE+1
	CB	*R3,@SPACE
	JH	LOOK
	B	@GOPROG

DOCMD3	CB	R1,@DOSCMD
	JNE	LOOK
DOCMD9	B	@RETURN

;*******************************************************************
;	LOOK - look up named file
;*******************************************************************
LOOK:	CALL	@PARSENAME
	CALL	@ICMD
	CALL	@SEG_SWITCH
;CHECK IF JUST FILE NAME TYPED IN
	CLR	@EXTWALK		; 0 = EXPLICIT EXTENSION, NO WALK
	CB	@FCB+EXTOFF,@SPACE
	JNE	L_START
;NO EXTENSION TYPED - WALK EXEC_TAB IN ORDER: COM, EXE, PRO
	LI	R0,EXEC_TAB
	MOV	R0,@EXTWALK

L_TRY:	MOV	@EXTWALK,R0
	MOVB	*R0,R1		; FIRST BYTE OF TABLE ENTRY
	JEQ	LOOKERR		; 0 = END OF TABLE, NOTHING MATCHED
	LI	R4,FCB+EXTOFF
	MOVB	*R0+,*R4+
	MOVB	*R0+,*R4+
	MOVB	*R0,*R4

L_START:	LI	R3,FCB
	LI	R2,SEARCH1
	CALL	@BDOS
	MOV	R1,R1
;	SEARCH1 returns -1 when there is no match.  JHE is UNSIGNED, so it
;	treated >FFFF as success - harmless while the extension was '???'
;	and the first search always matched, fatal once the walk has to
;	try a second entry.
	JLT	L_RETRY
	JMP	L_FOUND

L_RETRY	MOV	@EXTWALK,R0	; WAS THIS A WILDCARD WALK?
	JEQ	LOOKERR		; NO - EXPLICIT EXTENSION FAILED
	AI	R0,3		; NEXT TABLE ENTRY
	MOV	R0,@EXTWALK
	JMP	L_TRY

LOOKERR:	B	@CMDERR

L_FOUND:	LI	R2,FOPEN
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	LOOKERR
	LI	R4,FCB
	MOV	@FSZ(R4),@MFSZ
;	SEARCH1/FOPEN LEAVE THE DIRECTORY ENTRY IN FCB 0-31, SO FTY IS
;	THE BDOS'S OWN TYPE CODE - NO NEED TO DERIVE IT FROM THE EXTENSION
	MOVB	@FTY(R4),R1		; FILE TYPE FROM DIRECTORY ENTRY
	MOVB	R1,@MFTY		; KEEP FOR LOAD1
	SRL	R1,8
	CI	R1,PRO
	JEQ	L_PROC			; PROCEDURE FILE - INTERPRET, DON'T LOAD
	B	@LOAD
L_PROC:	B	@DOPROC

;*******************************************************************
;	PADSPACE - R2=count, R4=destination
;*******************************************************************
PADSPACE:	MOV	R2,R2
	JLE	PADRETS
PADLOOP:	MOVB	@SPACE,*R4+
	DEC	R2
	JH	PADLOOP
PADRETS:	RET

;*******************************************************************
;	CHKCHAR - check if char at *R3 is valid filename char
;*******************************************************************
CHKCHAR:	MOVB	*R3,R1
	SRL	R1,8
	CI	R1,'0'
	JL	INVALID
	CI	R1,'9'
	JLE	VALID
	ANDI	R1,00DFH
	AI	R1,-'A'
	CI	R1,001AH
	JH	INVALID
VALID:	CLR	R1
	JMP	SETFLAG
INVALID:	LI	R1,1
SETFLAG:	MOV	R1,R1
	RET

;*******************************************************************
;	SEG_SWITCH - deprecated v5.4 (transparent GAL mapping)
;*******************************************************************
SEG_SWITCH:	RET

SSWERR:	B	@PARSERR

;*******************************************************************
;	PARSENAME - parse filename from command line into FCB
;*******************************************************************
PARSENAME:	LI	R4,FCB
	LI	R2,NAMSIZ - EXTSIZ
	CLR	R0

PARSE1:	CALL	@CHKCHAR
	JNE	FILLNAME
	MOVB	*R3+,*R4+
	DEC	R2
	JEQ	FINDDOT
	JMP	PARSE1

FILLNAME:	CALL	@PADSPACE

FINDDOT:	CB	*R3+,@EXT
	JEQ	GETEXT
	DEC	R3
	LI	R2,EXTSIZ
	LI	R4,FCB + NAMSIZ - EXTSIZ
	CALL	@PADSPACE
	RET

EXT_TAB:	TEXT	'COM'
	TEXT	'EXE'
	TEXT	'BAS'
	TEXT	'BAT'
EXT_END:	BYTE	0
	EVEN

;	EXEC_TAB - extensions LOOK will try for a bare command name, in
;	precedence order.  Kept separate from EXT_TAB so SET_FTY's positional
;	codes are untouched.  BAS/BAT are deliberately absent: nothing
;	dispatches them, so a bare name must not resolve to one.
EXEC_TAB:	TEXT	'COM'
	TEXT	'EXE'
	TEXT	'PRO'
EXEC_END:	BYTE	0
	EVEN

GETEXT:	LI	R2,EXTSIZ
	LI	R4,FCB + NAMSIZ - EXTSIZ
NEXTEXT:	CALL	@CHKCHAR
	JNE	FILLEXT
	MOVB	*R3+,R1
	MOV	R1,R0
	SRL	R0,8
	CI	R0,'A'
	JL	EXTSTORE
	CI	R0,'Z'
	JLE	EXTSTORE
	CI	R0,'a'
	JL	EXTSTORE
	CI	R0,'z'
	JH	EXTSTORE
	ANDI	R1,0DF00H		;uppercase letters only
EXTSTORE:
	MOVB	R1,*R4+
	DEC	R2
	JEQ	FILLEXT
	JMP	NEXTEXT
;FILLEXT:	;CALL	@PADSPACE
FILLEXT: 	MOV   	R2,R2
	JLE  	 FILLX2
FILLX1:  	CLR   	R0
         	MOVB  	R0,*R4+
         	DEC   	R2
         	JH    	FILLX1
FILLX2:  	RET


;*******************************************************************
;	SET_FTY - derive file type from FCB extension, store in MFTY
;	FCB is absolute at 0280H - @FCB+EXTOFF etc are plain address constants
;	Uses R5 (table base), R6 (entry walk), R7 (type counter), R0 (scratch)
;
SET_FTY:
	LI	R5,EXT_TAB			; TABLE BASE
	CLR	R7				; TYPE CODE (0=SYS)
SFTY_LOOP:
	MOV	R5,R6				; R6 = ENTRY WALK POINTER
	MOVB	*R6+,R0				; BYTE 1
	JEQ	SFTY_NONE			; END OF TABLE
	INC	R7				; NEXT TYPE CODE
	CB	R0,@FCB+EXTOFF			; COMPARE BYTE 1
	JNE	SFTY_NEXT
	MOVB	*R6+,R0				; BYTE 2
	CB	R0,@FCB+EXTOFF+1		; COMPARE BYTE 2
	JNE	SFTY_NEXT
	MOVB	*R6,R0				; BYTE 3
	CB	R0,@FCB+EXTOFF+2		; COMPARE BYTE 3
	JEQ	SFTY_FOUND
SFTY_NEXT:
	AI	R5,3				; NEXT ENTRY
	JMP	SFTY_LOOP
SFTY_NONE:
	CLR	R7				; NO MATCH - SYS=0
SFTY_FOUND:
	SWPB	R7				; TYPE TO HIGH BYTE FOR MOVB
	MOVB	R7,@MFTY			; STORE TYPE CODE
	RET
;
;	LOAD - load executable file
;
;	FLA in FCB gives load address (0 = use TPA).
;	'.' prefix = flat load only, no execution, returns to prompt.
;	COM/EXE/type 0 = LOADERCODE (handles paged and raw binaries).
;*******************************************************************
LOAD:	CLR	R1
	MOVB	R1,@CMDLINE-2
	LI	R4,FCB
	MOV	@FLA(R4),R3
	JNE	LOAD2
	LI	R3,TPA		;DEFAULT FOR NON EXE OR COM FILES ETC
LOAD2	MOV	R3,@LADDR
	CLR	@CRN(R4)

	CB	@CMDLINE,@JUMP
	JNE	LOADRUN
LOADF3	DECT	SP
	MOV	R3,*SP
LOADF0	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	MOV	*SP+,R3
	CI	R1,-1
	JEQ	LOADF1
	AI	R3,BLKSIZ
	JMP	LOADF3
LOADF1
	MOV	R3,@FREEMEM
	B	@NEXTCMD

LOADRUN:
	MOVB	@FTY(R4),R1
	SRL	R1,8
	CI	R1,COM
	JNE	LT2
	B	@GOPROG
LT2	CI	R1,EXE
	JNE	LT3
	B	@GOPROG_EXE		;EXE - PAGED CHAIN FORMAT
;
;IS THIS CODE REDUNDANT?  E TO DO TO DO
;
LT3	CI	R1,0
	JNE	LT4
	B	@GOPROG
LT4
	CLR	@CRN(R4)
LOAD3	DECT	SP
	MOV	R3,*SP
LOAD0	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	MOV	*SP+,R3
	CI	R1,-1
	JEQ	LOAD1
	AI	R3,BLKSIZ
	JMP	LOAD3
LOAD1	MOV	R3,@FREEMEM

	MOVB	@MFTY,R1
	SRL	R1,8
	CI	R1,PRO
	JNE	LOAD1B
	B	@NEXTCMD
LOAD1B	CI	R1,TXT
	JNE	LOAD1C
	B	@NEXTCMD
LOAD1C	B	@NEXTCMD

;*******************************************************************
;	GOPROG - run loaded program via LOADERCODE
;*******************************************************************
GOPROG	LI	R4,CMDLINE
GOLOOP	INC	R4
	CB	*R4,@SPACE
	JH	GOLOOP
	CLR	R1
	MOVB	R1,@CMDLINE-1
	LI	R0,SHELL_PTR
	DECT	SP
	MOV	R0,*SP
	CALL	@INIT_LOADER
	B	@LOADER

;*******************************************************************
;	INIT_LOADER - copy LOADERCODE to LOADER (0x0300)
;*******************************************************************
INIT_LOADER:	LI	R2,LOADER
	LI	R1,LOADERCODE
IL0:	MOV	*R1+,*R2+
	CI	R1,END_LOADER
	JL	IL0
	RET

;*******************************************************************
;	GOPROG_EXE - stub for paged EXE chain format (v5.7)
;	Called when file type is EXE. Returns to caller.
;	Full implementation pending BDOS EXE type verification.
;*******************************************************************
;*******************************************************************
;	GOPROG_EXE - run EXE (paged chain format) via LOADERCODE_EXE
;*******************************************************************
GOPROG_EXE:
	CALL	@DBG_SWSCAN		;v6.4: consume a "-D" switch, set DBG_ON
	LI	R4,CMDLINE
GOLOOP_E:
	INC	R4
	CB	*R4,@SPACE
	JH	GOLOOP_E
	CLR	R1
	MOVB	R1,@CMDLINE-1
	LI	R0,SHELL_PTR
	DECT	SP
	MOV	R0,*SP
	CALL	@INIT_LOADER_EXE
	B	@LOADER

;*******************************************************************
;	INIT_LOADER_EXE - copy LOADERCODE_EXE to LOADER (0x0300)
;*******************************************************************
INIT_LOADER_EXE:
	LI	R2,LOADER
	LI	R1,LOADERCODE_EXE
ILE0:	MOV	*R1+,*R2+
	CI	R1,END_LOADER_EXE
	JL	ILE0
	RET

;*******************************************************************
;  LOADERCODE_EXE v5.7
;
;  Copied to LOADER (0x0300) by INIT_LOADER_EXE. Runs from COMMON.
;
;  Reads .EXE paged chain format produced by link99 v3.9.10.
;
;  Block header (8 bytes):
;    +0  next_offset  word  byte distance from THIS header to next (0=last)
;    +2  page         word  physical page (0=common/flat)
;    +4  start        word  virtual load address
;    +6  size         word  byte count of data following header
;    +8  [data...]
;
;  Single forward pass:
;    R6 -> header. Save R7=R6 (header start). Consume 4 words.
;    Capture R8 from first block start only.
;    MAP_SET if page != 0.
;    PSEL on. Copy size bytes from R6 to start. PSEL off.
;    If next_offset == 0 -> LDRRUN (launch).
;    R6 = R7 + next_offset. Loop.
;    Sector reload (LDRSEC_E) preserves R5/R7/R8 across BDOS.
;    After reload R6 = STAGING + (old R6 - STAGING end).
;
;  Branches to LDRRUN/LDRRUN_LOAD/LDRERR in shell (always resident).
;
;  Key registers:
;    R2   paged destination (start address, reset each block)
;    R3   byte count (saved across BDOS)
;    R4   end of STAGING = 0x0700
;    R5   next_offset (saved across block copy and BDOS)
;    R6   current STAGING pointer (header then data)
;    R7   header start (for next_offset arithmetic)
;    R8   launch address (first block start, never changed after)
;    R9   scratch / PSEL value
;*******************************************************************

;*******************************************************************
;  LOADERCODE_EXE v6.0 (Integrated Fixes)
;  Copied to LOADER (0x0300) by INIT_LOADER_EXE. Runs from COMMON.
;*******************************************************************
LOADERCODE_EXE:
	;--- CLEAR ALL MAP REGISTERS TO PAGE 0 ---
	LI	R12,MAP_WIN_BASE
	CLR	R0
	LI	R1,NUM_SEGS
LDRCL_E:
	LDCR	R0,BYTEWIDE
	INCT	R12
	DEC	R1
	JNE	LDRCL_E

	;--- READ INITIAL TWO SECTORS TO STAGING (0500H-08FFH) ---
	CLR	@DBG_COUNT
	LI	R9,DBG_LOG
	MOV	R9,@DBG_PTR
	CLR	R0
	LI	R3,0500H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JNE	LDREDET_E
	B	@LDRRUN			;EMPTY FILE

LDREDET_E:
	MOV	R1,R1
	JLT	LDRERR_B
	JMP	LDREDET_OK
LDRERR_B:
	B	@LDRERR

LDREDET_OK:
	;--- READ SECOND SECTOR TO 0700H ---
	LI	R3,0700H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS

	LI	R6,0500H		; R6 = FIRST BLOCK HEADER
	LI	R4,0900H		; R4 = END OF STAGING WINDOW
	CLR	R8			; R8=0 = LAUNCH ADDRESS NOT YET CAPTURED

;--- PROCESS ONE BLOCK HEADER (BOUNDARY IMMUNE) ---
LDRBLK_E:
	MOV	R6,R7		; R7 = HEADER START (FOR ARITHMETIC)
	MOV	*R6+,R5		; R5 = NEXT_OFFSET
	C	R6,R4
	JNE	LDRB1
	CALL	@LDRHDR_RL		; STAGING EXHAUSTED ON HEADER WORD
LDRB1:
	MOV	*R6+,R0		; R0 = PAGE
	C	R6,R4
	JNE	LDRB2
	CALL	@LDRHDR_RL
LDRB2:
	MOV	*R6+,R2		; R2 = START (COPY DESTINATION)
	C	R6,R4
	JNE	LDRB3
	CALL	@LDRHDR_RL
LDRB3:
	MOV	*R6+,R3		; R3 = SIZE IN BYTES

	;--- TRACE BLOCK HEADER TO LOG ---
	MOV	@DBG_PTR,R9
	MOV	R0,*R9+			; PAGE
	MOV	R2,*R9+			; START
	MOV	R3,*R9+			; SIZE
	MOV	R5,*R9+			; NEXT
	MOV	R9,@DBG_PTR
	INC	@DBG_COUNT

	;--- CAPTURE LAUNCH ADDRESS FROM FIRST BLOCK ONLY ---
	MOV	R8,R8
	JNE	LDRMAP_E
	MOV	R2,R8			; R8 = LAUNCH ADDRESS

	;--- PROGRAM MAPPER IF PAGED ---
LDRMAP_E:
	MOV	R0,R0
	JEQ	LDRCPY_E		; PAGE 0 = COMMON, SKIP MAPPER
	MOV	R2,R9
	SRL	R9,12			; SEGMENT = START >> 12
	BL	@MAP_SET

	;--- ENABLE PSEL AND COPY BLOCK R3 HOLD SIZE IN BYTES---
LDRCPY_E:
	MOV	R2,@DBG_CHKADDR		; DIAGNOSTIC: save original destination
	PSEL_EN
LDRCPYB_E:
	MOVB	*R6+,*R2+		; COPY WORD FROM STAGING BUFFER
	DEC	R3		; WE ARE MOVING BYTES
	JEQ	LDRDONE_E		; BLOCK IS COMPLETE
	C	R6,R4
	JL	LDRCPYB_E		; MORE DATA LEFT IN CURRENT STAGING

	;--- STAGING EXHAUSTED MID-BLOCK: RELOAD TWO SECTORS ---
	;  FIX: previously, EOF on the SECOND read jumped straight to
	;  LDRRUN, discarding the FIRST sector's data even though it
	;  had just been read successfully. This abandoned the rest of
	;  the current block -- and every block after it -- whenever a
	;  block's data happened to end mid-reload on an odd sector
	;  count. Now: EOF on read 1 = genuinely nothing new (abandon,
	;  unchanged). EOF on read 2 = first sector is still valid data
	;  -- process it (window pinned to 0x700, not 0x900) instead of
	;  discarding it. ---
LDRSEC_E:
	PSEL_DIS			; PSEL OFF BEFORE BDOS SYSTEM CALLS
	PUSH	R8
	PUSH	R7
	PUSH 	R5
	PUSH	R3
	PUSH	R2
	LI	R3,0500H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1			; CHECK FOR FILE EXHAUSTION (read 1)
	JEQ	LDRSEC_E_NONE		; nothing new at all -- true EOF
	LI	R3,0700H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1			; CHECK FOR FILE EXHAUSTION (read 2)
	JEQ	LDRSEC_E_HALF		; read 2 EOF -- sector 1 still valid
	LI	R0,0900H		; both sectors valid
	JMP	LDRSEC_E_RESTORE
LDRSEC_E_HALF:
	LI	R0,0700H		; only sector 1 valid -- window pinned here
	JMP	LDRSEC_E_RESTORE
LDRSEC_E_NONE:
	CLR	R0			; sentinel: nothing new, abandon to LDRRUN
LDRSEC_E_RESTORE:
	MOV	*SP+,R2			; RESTORE PAGED DESTINATION
	MOV	*SP+,R3			; RESTORE REMAINING WORD COUNT
	MOV	*SP+,R5			; RESTORE NEXT_OFFSET
	MOV	*SP+,R7			; RESTORE HEADER START
	MOV	*SP+,R8			; RESTORE LAUNCH ADDRESS
	MOV	R0,R0
	JEQ	LDRSEC_E_DONE		; sentinel 0 -> truly nothing left
	PSEL_EN
	LI	R6,0500H		; RESET DATA SOURCE TO START OF WINDOW
	MOV	R0,R4		; WINDOW END: 0x700 (partial) or 0x900 (full)
	JMP	LDRCPYB_E
LDRSEC_E_DONE:
	B	@LDRRUN		; FILE EOF REACHED, GENUINELY NOTHING NEW

	;--- BLOCK COPY COMPLETE ---
LDRDONE_E:
	;--- DIAGNOSTIC: read back first word just written, still mapped ---
	MOV	@DBG_CHKADDR,R1
	MOV	*R1,R0
;	MESG	@DBG_CHK
;	WHEX	R0
;	MESG	@DBG_NL
	;--- DIAGNOSTIC: read back LAST BYTE written (R2-2), still mapped -
	;    tests whether a mid-block staging reload corrupted anything
	;    after the point where it happened ---
	MOV	R2,R1
	DEC	R1
	DEC	R1
	MOV	*R1,R0
;	MESG	@DBG_CHKE
;	WHEX	R0
;	MESG	@DBG_NL
	;--- END DIAGNOSTIC ---

	PSEL_DIS			; PSEL OFF

	;--- FOLLOW CHAIN ---
	MOV	R5,R5
	JNE	LDRCHAIN_E
	B	@LDRRUN			; NEXT_OFFSET=0: FINAL BLOCK, LAUNCH!

LDRCHAIN_E:
	;--- v6.2: FOLLOW NEXT_OFFSET, DO NOT ASSUME WHERE THE COPY STOPPED
	;
	;  R6 was left wherever the block copy finished, i.e.
	;      header + 8 + size
	;  which is the next header ONLY when size is exactly 01F8.
	;  Every block LINK99 emitted until multi-page modules existed
	;  was padded to 01F8 and declared 01F8, so that held by
	;  coincidence and the omission never showed.
	;
	;  A module spanning several 4K pages must break its blocks at
	;  each page boundary, and those blocks are SHORT (40 bytes at
	;  the boundary).  R6 then lands inside the padding, zeros are
	;  decoded as a header, size comes back 0, and the copy loop's
	;  DEC R3 wraps 0 to FFFF - 65535 bytes written from address
	;  0000 over this loader's own workspace, the stack and STAGING.
	;  The board hangs with no output at all.
	;
	;  DOLOAD has always done this correctly on the same format
	;  (A R5,R7 / MOV R7,R6).  Only the EXE path failed to.
	;
	;  Harmless to existing images: for a 01F8 block this computes
	;  header+0200, byte for byte the value R6 already held.
	A	R5,R7			; R7 = HEADER + NEXT_OFFSET
	MOV	R7,R6			; R6 = NEXT HEADER

	;--- CHECK IF NEXT HEADER EXTENDS PAST CURRENT WINDOW ---
	;  JL LDRBLK_E directly is now out of range (LDRSEC_E grew
	;  when fixed) -- invert condition, skip an unconditional
	;  long branch instead. -
	C	R6,R4
	JHE	LDRCHAIN_FAR		; NOT(R6<R4) -- fetch fresh sectors below
	B	@LDRBLK_E		; IN STAGING WINDOW - GO DECODE IT
LDRCHAIN_FAR:

	;--- NEXT HEADER ENTIRELY BEYOND STAGING: FETCH FRESH SECTORS ---
	;  FIX: previously this always set R4=0900H (both sectors
	;  valid) regardless of whether either read actually hit EOF --
	;  same bug class as LDRSEC_E, but worse here since even a
	;  first-read EOF was never checked at all. A file whose true
	;  end lands exactly inside this fetch would have the loader
	;  read stale/garbage bytes and treat them as a real chain-
	;  block header -- exactly the "jump to a nonsensical address"
	;  crash this build hit. Same 3-way fix as LDRSEC_E: read 1 EOF
	;  = nothing new (abandon to LDRRUN); read 2 EOF = sector 1
	;  still valid (window pinned to 0x700); both succeed = 0x900. ---
	DECT	SP
	MOV	R8,*SP			; SAVE ACTIVE LAUNCH ADDRESS
	LI	R3,0500H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1			; CHECK FOR FILE EXHAUSTION (read 1)
	JEQ	LDRCH_NONE		; nothing new at all -- true EOF
	LI	R3,0700H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1			; CHECK FOR FILE EXHAUSTION (read 2)
	JEQ	LDRCH_HALF		; read 2 EOF -- sector 1 still valid
	LI	R0,0900H		; both sectors valid
	JMP	LDRCH_RST
LDRCH_HALF:
	LI	R0,0700H		; only sector 1 valid -- window pinned here
	JMP	LDRCH_RST
LDRCH_NONE:
	CLR	R0			; sentinel: nothing new, abandon to LDRRUN
LDRCH_RST:
	MOV	*SP+,R8			; RESTORE ACTIVE LAUNCH ADDRESS
	MOV	R0,R0
	JEQ	LDRCH_DONE		; sentinel 0 -> truly nothing left
	LI	R6,0500H		; CLEAN ALIGNMENT: START OF NEW WINDOW
	MOV	R0,R4			; WINDOW END: 0x700 (partial) or 0x900 (full)
	B	@LDRBLK_E
LDRCH_DONE:
	B	@LDRRUN			; FILE EOF REACHED, GENUINELY NOTHING NEW

	;--- SUBROUTINE: SPLIT-HEADER SECTOR REFILL ---
	;  FIX: R0 (page) and R2 (start) are live, already-decoded
	;  header fields when this is called from LDRB2/LDRB3 -- but
	;  R2 is explicitly overwritten below (LI R2,SETDMA/RDSEQ as
	;  BDOS call codes), and R0 is at risk from BDOS internals.
	;  Neither was saved/restored before, only R5/R8/R11 -- a
	;  header split landing exactly at the LDRB2/LDRB3 point
	;  silently corrupted the just-decoded page or start value. ---
LDRHDR_RL:
	PSEL_DIS			; PSEL OFF BEFORE BDOS CALLS
	PUSH	R8			; SAVE LAUNCH ADDRESS
	PUSH	R5			; SAVE NEXT_OFFSET
	PUSH	R2			; SAVE START (clobbered below)
	PUSH	R0			; SAVE PAGE
	LI	R3,0500H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JEQ	LDRHD_EOF
	LI	R3,0700H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
LDRHD_EOF:
	MOV	*SP+,R0			; RESTORE PAGE
	MOV	*SP+,R2			; RESTORE START
	MOV	*SP+,R5
	MOV	*SP+,R8			; RESTORE LAUNCH ADDRESS
	LI	R6,0500H		; DATA POINTER TO START OF FRESH BUFFER
	LI	R4,0900H		; END WINDOW RESTORED
	RET			; RET RUN

END_LOADER_EXE:	EQU	$+0
;*******************************************************************
;  LOADERCODE v5.7
;
;  Copied to LOADER (0x0300) by INIT_LOADER. Runs from COMMON.
;  Handles .COM flat binary files only.
;  .EXE paged chain format is handled by LOADERCODE_EXE.
;
;  Load sequence:
;    1. Read first sector to STAGING
;    2. Copy STAGING to LADDR, read remaining sectors to LADDR+N
;    3. Launch from LADDR (no PSEL, mapper untouched)
;
;  Key registers:
;    R3   sector DMA address / load pointer
;    R9   launch address (= LADDR)
;*******************************************************************

LOADERCODE:

;--- ENSURE PSEL DISABLED BEFORE ANY BDOS CALLS ---
	CLR	R15
	ORI	R15,0007H		;INTERRUPT MASK=7, PSEL BIT CLEAR
	LST	R15

;--- READ FIRST SECTOR TO STAGING (0x0500) ---
	CLR	R0
	LI	R3,0500H		;STAGING BUFFER
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JNE	LDRDET
	B	@LDRRUN_F		;EMPTY FILE
LDRDET:	MOV	R1,R1
	JLT	LDRDET_ERR
	JMP	LDRRAW
LDRDET_ERR:
	B	@LDRERR

;--- RAW BINARY: LOAD TO LADDR, LAUNCH FROM LADDR ---
LDRRAW:	;MOV	@LADDR,R9		;R9 = LAUNCH ADDRESS
	LI	R3,0500H		;COPY STAGING -> LADDR
	MOV	@LADDR,R4
LDRRAW1:	MOV	*R3+,*R4+
	CI	R3,0700H		;END OF STAGING
	JL	LDRRAW1
	MOV	@LADDR,R3
	AI	R3,BYTSEC		;NEXT SECTOR
	MOV	R3@FREEMEM

LDRRAWS:	DECT	SP
	MOV	R3,*SP
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	MOV	*SP+,R3
	CI	R1,-1
	JNE	LDRRAWS1
	B	@LDRRUN_F
LDRRAWS1:
	MOV	R1,R1
	JLT	LDRRAWS_ERR
	AI	R3,BYTSEC
	MOV	R3,@FREEMEM
	JMP	LDRRAWS
LDRRAWS_ERR:
	B	@LDRERR

;--- LAUNCH RAW/FLAT (NO PSEL) ---
LDRRUN_F:
	MOV	@LOAD_ONLY,R0		;LOAD ONLY?
	JEQ	LDRRUN_F1		;NO - EXECUTE
	B	@LDRRUN_LOAD		;YES - ABSOLUTE BRANCH TO SHELL
LDRRUN_F1:
;	LI	R0,INT2_HANDLER		;INSTALL INT2 DEBUG HANDLER
;	MOV	R0,@INT2_VEC
	PSEL_DIS			;PAGE-0 SHELL VISIBLE DURING MAP SETUP
	CLR	R15			;CLEAR ALL STATUS BITS
	ORI	R15,0007H		;ST7=0=PRIVILEGED, INTERRUPT MASK=7
	LST	R15

	; Private application RAM: C,D -> physical page 1.
	LI	R12,MAP_WIN_BASE+(SEGC*2)
	LI	R0,APAGE
	SLA	R0,8
	LDCR	R0,BYTEWIDE
	INCT	R12
	LDCR	R0,BYTEWIDE

	LI	R0,0E000H
	MOV	R0,@MEMLIMIT
	MOV	@LADDR,R8		;preserve exact launch address
	B	@LGATE			;COMMON enables PSEL then launches

LDRERR:	MESG	@TXT_LDRERR
	B	@RETURN

TXT_LDRERR:	TEXT	'--Loader read error'
		BYTE	0DH,0AH,0
		EVEN
TXT_LOADED:	TEXT	'Loaded'
		BYTE	0DH,0AH,0
		EVEN

END_LOADER:	EQU	$+0

;*******************************************************************
;  LDRRUN / LDRRUN_LOAD - permanent shell routines
;  Called by both LOADERCODE (COM) and LOADERCODE_EXE (EXE).
;  Must live in protected shell segments, never inside a LOADERCODE
;  block. Absolute B @LDRRUN branches from COMMON are safe because
;  shell is always resident in segments 12-15.
;*******************************************************************

;--- LAUNCH PAGED PROGRAM (PSEL WILL BE ENABLED) ---
LDRRUN:	CALL	@DUMP_EXE_TRACE		;PRINT SAFE TRACE AFTER LOAD COMPLETE
	CALL	@SET_MEM_EXE		;v6.1 SET PAGED-EXE HEAP WINDOW (FREEMEM/MEMLIMIT)
	MOV	@LOAD_ONLY,R0		;LOAD ONLY?
	JNE	LDRRUN_LOAD		;YES - SKIP EXECUTE
;	LI	R0,INT2_HANDLER
;	MOV	R0,@INT2_VEC
	CLR	R15
	ORI	R15,0007H		;ST7=0=PRIVILEGED, INTERRUPT MASK=7
	LST	R15
	PSEL_EN
	B	*R8			;LAUNCH FROM R8

LDRRUN_LOAD:
	PSEL_DIS			;DISABLE PSEL
	CLR	R0
	MOV	R0,@LOAD_ONLY		;CLEAR FLAG
	MESG	@TXT_LOADED		;CONFIRM LOAD
	B	@NEXTCMD		;BACK TO SHELL PROMPT

;*******************************************************************
;	SET_MEM_EXE (v6.1) - establish the heap window for a paged EXE
;
;	The paged chain loader (LOADERCODE_EXE) never set FREEMEM or
;	MEMLIMIT, so a paged program inherited a STALE heap base left by
;	an earlier flat load. Its C runtime then allocated file buffers
;	on top of its own resident code -> flaky INT2 / corruption.
;
;	FREEMEM  = top of the loaded page-0 (common) image. Found by
;	           scanning the block trace already in DBG_LOG for the
;	           highest (start+size) among page-0 records.
;	MEMLIMIT = 08000H, base of the paged overlay window. A paged
;	           program's heap MUST stay in [resident_top .. 07FFFH];
;	           08000H-0BFFFH is remapped per overlay, 0E000H+ is BDOS.
;
;	Preserves R8 (LDRRUN needs it as the launch address).
;*******************************************************************
SET_MEM_EXE:
;
;	v6.2: MEMLIMIT is now COMPUTED, not assumed to be 08000H.
;
;	The old value was the base of the overlay window as it happened
;	to be used at the time.  A program whose resident image reaches
;	above 08000H - which is legal, the window only has to start above
;	the image - then got FREEMEM > MEMLIMIT, so alloc() failed on its
;	very first call and every fopen() returned 0.  R99 hit exactly
;	this: image top 08E00H, ceiling 08000H, no heap at all.
;
;	The ceiling is the base of the LOWEST segment any overlay block
;	maps, because those addresses are time-shared with overlay pages
;	and cannot be given to the heap.  A program with no overlay
;	blocks keeps the full 0C000H, which is the true top of RAM below
;	the shell.
;
;	Both values come from the one pass over DBG_LOG that was already
;	here for FREEMEM.
;
	LI	R1,DBG_LOG		;R1 -> first block-trace record
	MOV	@DBG_COUNT,R2		;R2 = number of records
	CI	R2,144			;clamp to DBG_LOG capacity
	JLE	SME_CLOK
	LI	R2,144
SME_CLOK:
	LI	R3,01000H		;running top, floored at the EXE base
	LI	R6,0C000H		;running ceiling, no overlays = top of RAM
SME_LOOP:
	MOV	R2,R2
	JEQ	SME_DONE
	MOV	*R1+,R4			;R4 = page
	MOV	*R1+,R5			;R5 = start
	MOV	*R1+,R0			;R0 = size
	INCT	R1			;skip next-offset word
	MOV	R4,R4			;page 0 = common, else paged
	JNE	SME_PAGED
	A	R5,R0			;R0 = start + size = end of block
	C	R0,R3
	JLE	SME_NEXT
	MOV	R0,R3			;new high-water mark
	JMP	SME_NEXT
SME_PAGED:
	MOV	R5,R0			;paged block: base of ITS segment
	ANDI	R0,0F000H
	C	R0,R6
	JHE	SME_NEXT
	MOV	R0,R6			;new lowest overlay segment
SME_NEXT:
	DEC	R2
	JMP	SME_LOOP
SME_DONE:
	MOV	R3,@FREEMEM		;heap base = top of the page-0 image
	MOV	R6,@MEMLIMIT		;heap ceiling = lowest overlay segment
	RET

;*******************************************************************
;	DUMP_EXE_TRACE - print EXE block trace after loading is complete
;
;	The loader only records words to DBG_LOG. This routine does the
;	MESG/WHEX output later, when loader copy state is no longer live.
;	It preserves only R8, because LDRRUN needs R8 as launch address.
;*******************************************************************
DUMP_EXE_TRACE:
	MOV	@DBG_ON,R0		;v6.4: only when "-D" was on the command line
	JNE	DMP_EXE_GO
	RET
DMP_EXE_GO:
	MOV	R8,@DBG_SAVE8
	LI	R0,DBG_LOG
	MOV	R0,@DBG_DPTR
	MOV	@DBG_COUNT,@DBG_DCOUNT
	;--- clamp to the log's 144-record capacity so a count that is
	;    somehow larger can never walk the dump past DBG_LOG ---
	MOV	@DBG_DCOUNT,R0
	CI	R0,144
	JLE	DMP_EXE_CLOK
	LI	R0,144
	MOV	R0,@DBG_DCOUNT
DMP_EXE_CLOK:
DMP_EXE_LOOP:
	MOV	@DBG_DCOUNT,R0
	JEQ	DMP_EXE_DONE
	MOV	@DBG_DPTR,R4
	MOV	*R4+,@DBG_V0		;PAGE
	MOV	*R4+,@DBG_V1		;START
	MOV	*R4+,@DBG_V2		;SIZE
	MOV	*R4+,@DBG_V3		;NEXT
	MOV	R4,@DBG_DPTR

	MESG	@DBG_OB
	MOV	@DBG_V0,R0
	WHEX	R0
	MESG	@DBG_SP
	MOV	@DBG_V1,R0
	WHEX	R0
	MESG	@DBG_SP
	MOV	@DBG_V2,R0
	WHEX	R0
	MESG	@DBG_SP
	MOV	@DBG_V3,R0
	WHEX	R0
	MESG	@DBG_CB

	DEC	@DBG_DCOUNT
	JMP	DMP_EXE_LOOP
DMP_EXE_DONE:
	MOV	@DBG_SAVE8,R8
	RET

;*******************************************************************
;	DBG_SWSCAN (v6.4) - EXE debug switch
;
;	Called from GOPROG_EXE only, so the COM/flat path (LDRRUN_F,
;	which never calls DUMP_EXE_TRACE) is untouched.
;
;	Scans CMDLINE for a space-delimited "-D" token.  Found: sets
;	DBG_ON non-zero and REMOVES the token, with its leading space,
;	from the line - so the application never sees it and CMDL_SIZE
;	still matches the text at 00A0.  Not found: clears DBG_ON.
;	The line is already uppercased by PROMPT, so only 'D' is tested.
;	Runs before the FCB is used by the loader and long after
;	PARSENAME, so file lookup is unaffected.  Uses R0,R1,R4,R5.
;*******************************************************************
DBG_SWSCAN:
	CLR	R0
	MOV	R0,@DBG_ON		;default: trace off
	LI	R4,CMDLINE
DBGS1:	MOVB	*R4,R1
	JEQ	DBGS9			;NUL - end of line
	CB	R1,@CR
	JEQ	DBGS9
	CB	R1,@SPACE		;token boundary?
	JNE	DBGS2
	CB	@1(R4),@SWITCH		;'-' ?
	JNE	DBGS2
	CB	@2(R4),@DBGCHR		;'D' ?
	JNE	DBGS2
	MOVB	@3(R4),R1		;must be the whole token
	JEQ	DBGS3
	CB	R1,@CR
	JEQ	DBGS3
	CB	R1,@SPACE
	JEQ	DBGS3
DBGS2:	INC	R4
	JMP	DBGS1
;--- found: R4 points at the space in front of "-D" ---
DBGS3:	SETO	R0
	MOV	R0,@DBG_ON		;trace on for this load
	MOV	R4,R5			;R5 = destination
	AI	R4,3			;R4 = source, just past " -D"
DBGS4:	MOVB	*R4+,*R5+		;close the gap, terminator included
	JNE	DBGS4
	LI	R0,3
	S	R0,@CMDL_SIZE		;keep the length the app sees honest
DBGS9:	RET

DBGCHR	BYTE	'D'
	EVEN

;*******************************************************************
;  V6.3 COMMON GATES
;
;  Copied by INIT22 into the verified free gap >02E8->02FF:
;
;    >02E8..02EB  LGATE  PSEL_EN / B *R8
;    >02EC..02EF         unused
;    >02F0..02F5  RGATE  PSEL_DIS / B @RETURN
;    >02F6..02FF  BGATE  PSEL_DIS / CALL @BDOS / PSEL_EN / RET
;
;  BGATE is used by application BDOS_PTR (>0084).  Shell code itself
;  continues to CALL @BDOS directly.
;*******************************************************************
LSRC:
	PSEL_EN
	B	*R8
LEND:

RSRC:
	PSEL_DIS
	B	@RETURN
REND:

BSRC:
	PSEL_DIS
	CALL	@BDOS
	PSEL_EN
	RET
BEND:

;*******************************************************************
;	RETURN - program exit
;*******************************************************************
RETURN:
	; Make the page-0 invariant explicit before normal Shell recovery.
	LI	R12,MAP_WIN_BASE+(SEGC*2)
	CLR	R0
	LDCR	R0,BYTEWIDE		;C -> page 0
	INCT	R12
	LDCR	R0,BYTEWIDE		;D -> page 0
	BL	@MAP_INIT
	LI	R0,TPA			;v6.1 restore shell heap defaults on program exit
	MOV	R0,@FREEMEM
	LI	R0,SHELL
	MOV	R0,@MEMLIMIT
	MOVB	R1,@CMDLINE-2
	LWPI	WORKSP
	LI	SP,STACKP
	CLR	R15
	MOVB	@CMDLINE-2,R1
	SRA	R1,8
	CI	R1,-1
	JNE	NEXTCMD
	CLR	R1
	MOVB	R1,@CMDLINE-2
	MOV	R1,R1
	JEQ	NEXTCMD
	B	@UNPROC

;*******************************************************************
;	NEXTCMD / PROMPT
;*******************************************************************
NEXTCMD	MOVB	@PROCSW,R1
	JEQ	PROMPT
	B	@PFETCH

PROMPT:	MOVB	@PROM,R3
	CALL	@OUTCHAR
	LI	R4,CMDLINE
	LI	R5,CLSZ
CINLOOP	MOV	@CONSOLE,R1
	CALL	@INCHAR
	CB	R1,@BS
	JEQ	RUBOUT
	CB	R1,@DEL
	JEQ	RUBOUT
	CB	R1,@CTLC
	JNE	STOWIT
	MOVB	@CR,R1
	MOVB	R1,@CMDLINE

STOWIT	MOV	R1,R0
	SRL	R0,8
	CI	R0,61H
	JL	STOWIT2
	CI	R0,7AH
	JH	STOWIT2
	AI	R0,-20H
	SWPB	R0
	MOVB	R0,*R4+
	JMP	STOWIT2+2
STOWIT2	MOVB	R1,*R4+
	DEC	R5
	JLE	CIOERR
	CB	R1,@SPACE
	JHE	ECHO
	CLR	R0
	MOVB	@CR,R1
	MOVB	R0,*R4
ECHO	MOV	R1,R3
	CALL	@OUTCHAR
	CLR	@SKIPSW
	CB	R1,@LF
	JEQ	GODOCMD
	JMP	CINLOOP
RUBOUT	CI	R5,CLSZ
	JHE	CINLOOP
	INC	R5
	DEC	R4
	DECT	SP
	MOV	R4,*SP
	LI	R4,RUBMSG
	CALL	@OUTSTR
	MOV	*SP+,R4
	JMP	CINLOOP
GODOCMD	LI	R0,CMDLINE
	S	R0,R4
	MOV	R4,@CMDL_SIZE
	B	@DOCMD
CIOERR	B	@LINERR

;*******************************************************************
;	INTERNAL COMMANDS
;*******************************************************************
CMDCNT	EQU	5
ICLIST	TEXT	"DIR"
	BYTE	0
	WORD	DSKDIR
	TEXT	"SAVE"
	BYTE	0
	WORD	DSKSAVE
	TEXT	"ERA"
	BYTE	0
	WORD	ERAFILE
	TEXT	"TYPE"
	BYTE	0
	WORD	TYPEFILE
	TEXT	"LOAD"
	BYTE	0
	WORD	DOLOAD
	EVEN

BUFPNT	WORD	0
RECCNT	WORD	0
LOAD_ONLY:	WORD	0			;NON-ZERO = LOAD WITHOUT EXECUTE
SADDR	WORD	0
SWITCH	BYTE	'-'
	EVEN

ICMD	LI	R1,ICLIST
	LI	R4,FCB
	LI	R5,CMDCNT
ICMD0	CB	*R4+,*R1+
	JEQ	ICMD0
	DEC	R1
	DEC	R4
	CB	*R4,@SPACE
	JH	ICMD1
	MOVB	*R1,R0
	JNE	ICMD1
	INC	R1
	MOVB	*R1+,R2
	SWPB	R2
	MOVB	*R1+,R2
	SWPB	R2
	MOV	*SP+,R0
	B	*R2
ICMD1	DEC	R5
	JEQ	ICMDE
ICMD2	MOVB	*R1+,R0
	JNE	ICMD2
	INCT	R1
	LI	R4,FCB
	JMP	ICMD0
ICMDE	RET

;*******************************************************************
;	DIR
;*******************************************************************
BAR	TEXT	' : '
	BYTE	0
CRLF	BYTE	0DH,0AH,0
SEP	TEXT	'  '
	BYTE	0
MNOFILE	TEXT	'NO FILES'
	BYTE	0DH,0AH,0
	EVEN
DIRCOLS	EQU	4
CCOUNT	WORD	0
	EVEN

DSKDIR:	CLR	R0
	MOV	R0,@CCOUNT
	LI	R1,'?'*256
	LI	R0,NAMSIZ
	LI	R8,FCB
	MOV	R8,R2
DSKDIR0	MOVB	R1,*R2+
	DEC	R0
	JNE	DSKDIR0
	LI	R2,SEARCH1
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	NOFILE
	CALL	@PNAME
DSKDIR1	LI	R2,SEARCH2
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	DIREXIT
	CALL	@PNAME
	JMP	DSKDIR1

PNAME	MOV	R3,R1
	LI	R0,NAMSIZ
PNAME2	DECT	SP
	MOV	R0,*SP
	MOVB	*R1+,R3
	SWPB	R3
	DECT	SP
	MOV	R1,*SP
	LI	R2,COUT
	CALL	@BDOS
	MOV	*SP+,R1
	MOV	*SP+,R0
	DEC	R0
	JNE	PNAME2
	INC	@CCOUNT		;ONE MORE NAME ON THIS LINE
	MOV	@CCOUNT,R0
	CI	R0,DIRCOLS		;FILLED A ROW OF 4?
	JLT	PNAMESP		;NO  : PRINT COLUMN GAP
	CLR	R0		;YES : START A NEW LINE
	MOV	R0,@CCOUNT
	MESG	@CRLF
	JMP	PNAME3
PNAMESP	MESG	@SEP
PNAME3	RET

DIREXIT	MESG	@CRLF
	CLR	R1
	B	@RETURN
NOFILE	MESG	@MNOFILE
	CLR	R1
	B	@CMDERR

;*******************************************************************
;	SAVE
;*******************************************************************
CMDPTR	EQU	0A0H
PARSERR	B	@PARSMSG

DSKSAVE:	CLR	@BUFPNT
	CLR	@RECCNT
	LI	R3,TPA		;DEFAULT SAVE ADDRESS
	MOV	R3,@SADDR
	LI	R3,CMDLINE
START00	CB	*R3+,@SPACE
	JH	START00
	DEC	R3
START02	CB	*R3,@CR
	JEQ	PARSERR
	CB	*R3+,@SPACE
	JLE	START02
	DEC	R3
	MOV	R3,@BUFPNT
	CALL	@ATOD
	MOV	R1,R1
	JEQ	PARSERR
	MOV	R1,@RECCNT
	MOV	@BUFPNT,R3
PREPARSE	CB	*R3,@CR
	JEQ	PARSERR
	CB	*R3+,@SPACE
	JLE	PREPARSE
	DEC	R3
	CALL	@PARSENAME
NAM2	CB	*R3+,@SPACE
	JEQ	NAM2
	DEC	R3
	CB	*R3,@CR
	JEQ	NAMSRCH
	CB	*R3+,@SWITCH
	JNE	PARSERR
	MOV	R3,@BUFPNT
	CALL	@CATOH
	MOV	R1,R1
	JEQ	PARSERR
	MOV	R1,@SADDR
NAMSRCH	LI	R2,SEARCH1
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	NAM5
NAM3	LI	R2,ERAFIL
	LI	R3,FCB
	CALL	@BDOS
NAM5	LI	R2,MAKFIL
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JHE	SKMK1
	B	@MKERR
SKMK1:
	LI	R4,FCB
	MOV	@SADDR,R3
	MOV	R3,@FLA(R4)
	CLR	@CRN(R4)
WRDATA	DECT	SP
	MOV	R3,*SP
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,WRSEQ
	LI	R3,FCB
	CALL	@BDOS
	MOV	*SP+,R3
	MOV	R1,R1
	JHE	SKWR1
	B	@WRITERR
SKWR1:
	C	R3,@MEMLIMIT
	JL	SKLG1
	B	@LARGERR
SKLG1:
	AI	R3,BYTSEC
	DEC	@RECCNT
	JNE	WRDATA
WRDATAC	LI	R2,FCLOSE
	LI	R3,FCB
	CALL	@BDOS
EXIT	CLR	R1
	B	@RETURN

;*******************************************************************
;	ERASE
;*******************************************************************
ERAPERR	B	@PARSMSG

ERAFILE	CLR	@RECCNT
	CLR	@BUFPNT
	LI	R3,TPA
	MOV	R3,@SADDR
	LI	R3,CMDLINE
ERA0	CB	*R3+,@SPACE
	JH	ERA0
	DEC	R3
ERA01	CB	*R3,@CR
	JEQ	ERAPERR
	CB	*R3+,@SPACE
	JLE	ERA01
	DEC	R3
	CALL	@PARSENAME
ERA4	LI	R2,SEARCH1
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	ERAE
	LI	R2,ERAFIL
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JHE	SKMK2
	B	@MKERR2
SKMK2:
ERAE	CLR	R1
	B	@RETURN

;*******************************************************************
;	Error handlers
;*******************************************************************
WRITERR	MESG	@ERRMSG4
	JMP	MKERR2
MKERR	B	@MONITOR
	MESG	@ERRMSG3
	JMP	MKERR2
CLOSERR	MESG	@ERRMSG1
	JMP	MKERR2
PARSMSG	MESG	@ERRMSG2
	B	@NEXTCMD
LARGERR	MESG	@ERRMSG5
	JMP	MKERR2
MKERR2	LI	R2,FCLOSE
	LI	R3,FCB
	CALL	@BDOS
	B	@RETURN

;*******************************************************************
;	TYPE - print a text file to the console
;
;	Usage: TYPE filename.ext
;	Parses the filename (with extension) via PARSENAME, opens it,
;	reads sector by sector into STAGING, and sends each byte to
;	the console with BDOS COUT. Stops at CTRL-Z or file EOF.
;*******************************************************************
;*******************************************************************
;	LOAD - load overlay into paged memory without executing
;
;	Usage: LOAD filename
;	Loads the COM file, programs mapper registers per pagemap,
;	copies code to paged memory, returns to shell without executing.
;*******************************************************************
DOLOAD:
	;--- SKIP 'LOAD', PARSE OVERLAY FILENAME ---
	LI	R3,CMDLINE
DLSK1	CB	*R3+,@SPACE		;SKIP COMMAND NAME
	JH	DLSK1
	DEC	R3
DLSK2	CB	*R3,@CR			;END OF LINE?
	JNE	DLSK_E
	B	@DLERR
DLSK_E	CB	*R3+,@SPACE		;SKIP SPACES
	JLE	DLSK2
	DEC	R3
	CALL	@PARSENAME		;FCB = OVERLAY NAME+EXT

	;--- OPEN FILE ---
	LI	R4,FCB
	CLR	@CRN(R4)
	LI	R2,FOPEN
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JHE	DLSK_F
	B	@DLERR
DLSK_F

	;--- READ FIRST SECTOR ---
	LI	R3,STAGING
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JNE	DLSK_G
	B	@DLERR
DLSK_G

	;--- PROCESS CHAIN BLOCKS ---
	; Header: next_offset(w) page(w) start(w) size(w) [data]
	LI	R6,STAGING			; CURRENT POINTER
	LI	R8,STAGING+512			; END OF STAGING

DLBLK:
	MOV	R6,R7				; R7 = HEADER START
	MOV	*R6+,R5		; R5 = NEXT_OFFSET
	MOV	*R6+,R4		; R4 = PAGE
	MOV	*R6+,R2		; R2 = START (DESTINATION)
	MOV	*R6+,R3		; R3 = SIZE IN BYTES

	;--- DIAGNOSTIC: dump page/start/size for every chain block ---
	MESG	@DBG_BLK
	MOV	R4,R0
	WHEX	R0
	MESG	@DBG_SEP
	MOV	R2,R0
	WHEX	R0
	MESG	@DBG_SEP
	MOV	R3,R0
	WHEX	R0
	MESG	@DBG_NL
	;--- END DIAGNOSTIC ---

	;--- MAP_SET IF PAGED ---
	MOV	R4,R0
	JEQ	DLCPY_S				; PAGE 0 = NO MAP_SET
	MOV	R2,R9
	SRL	R9,12				; SEGMENT = START>>12
	BL	@MAP_SET			; R9=SEGMENT R0=PAGE

DLCPY_S:	PSEL_EN				; PSEL ON
	SRL	R3,1				; BYTES TO WORDS
DLCPY:
	MOV	*R6+,*R2+			; COPY WORD
	DEC	R3
	JEQ	DLDONE_B			; BLOCK DONE
	C	R6,R8
	JL	DLCPY

	;--- STAGING EXHAUSTED - RELOAD ---
	PSEL_DIS				; PSEL OFF
	DECT	SP
	MOV	R7,*SP				; SAVE HEADER START
	DECT	SP
	MOV	R5,*SP				; SAVE NEXT_OFFSET
	DECT	SP
	MOV	R3,*SP				; SAVE WORD COUNT
	DECT	SP
	MOV	R2,*SP				; SAVE DESTINATION
	LI	R3,STAGING
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	MOV	*SP+,R2
	MOV	*SP+,R3
	MOV	*SP+,R5
	MOV	*SP+,R7
	CI	R1,-1
	JEQ	DLDONE_B			; EOF
	PSEL_EN
	LI	R6,STAGING
	LI	R8,STAGING+512
	JMP	DLCPY

DLDONE_B:
	PSEL_DIS				; PSEL OFF
	MOV	R5,R5
	JEQ	DLDONE				; NEXT_OFFSET=0: LAST BLOCK
	A	R5,R7
	MOV	R7,R6				; R6 = NEXT HEADER
	C	R6,R8
	JL	DLBLK				; IN STAGING
	;--- NEXT HEADER BEYOND STAGING: RELOAD ---
	S	R8,R6				; OVERSHOOT
	DECT	SP
	MOV	R5,*SP
	DECT	SP
	MOV	R6,*SP				; SAVE OVERSHOOT
	LI	R3,STAGING
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	MOV	*SP+,R6
	MOV	*SP+,R5
	LI	R8,STAGING+512
	AI	R6,STAGING			; R6 = STAGING + OVERSHOOT
	JMP	DLBLK

DLDONE:
	MESG	@DLTXT_OK
	B	@NEXTCMD

DLERR	MESG	@DLTXT_ERR
	B	@NEXTCMD

DLTXT_OK	TEXT	'Loaded as overlay '
	BYTE	0
	EVEN
DLTXT_CRLF	BYTE	0DH,0AH,0
	EVEN
DLTXT_ERR	TEXT	'--Load error'
	BYTE	0DH,0AH,0
	EVEN

TYPERR	MESG	@MNOFILE
	B	@NEXTCMD

TYPEFILE:
	; R3 already points at the delimiter following TYPE.
	; Skip spaces, then parse the filename.
TYSK2	MOVB	*R3,R0
	JEQ	TYPARSE_ERR		;NULL = no filename
	CB	R0,@CR
	JEQ	TYPARSE_ERR		;CR = no filename
	CB	*R3+,@SPACE
	JLE	TYSK2
	DEC	R3
	CALL	@PARSENAME		;FCB = NAME+EXT
	JMP	TYPE_OPEN

TYPARSE_ERR:
	B	@PARSMSG

TYPE_OPEN:

	;--- OPEN FILE ---
	LI	R4,FCB
	CLR	@CRN(R4)
	LI	R2,FOPEN
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	TYPERR

	;--- READ NEXT SECTOR TO STAGING ---
TYSEC	LI	R3,STAGING
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JEQ	TYDONE			;FILE EOF

	;--- PRINT SECTOR: R6 = PTR, R7 = BYTE COUNT ---
	LI	R6,STAGING
	LI	R7,BLKSIZ
TYCH	MOVB	*R6+,R3
	CB	R3,@CTLZ		;CTRL-Z = TEXT EOF
	JEQ	TYDONE
	SWPB	R3			;CHAR TO LOW BYTE FOR COUT
	DECT	SP
	MOV	R6,*SP			;SAVE PTR ACROSS BDOS
	DECT	SP
	MOV	R7,*SP			;SAVE COUNT ACROSS BDOS
	LI	R2,COUT
	CALL	@BDOS
	MOV	*SP+,R7
	MOV	*SP+,R6
	DEC	R7
	JNE	TYCH
	JMP	TYSEC			;NEXT SECTOR

	;--- CLOSE AND RETURN TO SHELL ---
TYDONE	LI	R2,FCLOSE
	LI	R3,FCB
	CALL	@BDOS
	MESG	@CRLF
	CLR	R1
	B	@RETURN



;*******************************************************************
;	ASCII conversion utilities
;*******************************************************************
ATOD	CLR	R3
	LI	R8,10
ATOD00	MOV	@BUFPNT,R0
	MOVB	*R0,R2
	SRL	R2,8
	AI	R2,-'0'
	JLT	ATOD03
	CI	R2,10
	JLT	ATOD04
ATOD03	MOV	R3,R1
	RET
ATOD04	MOV	R2,R0
	MOV	R3,R2
	MPY	R8,R2
	A	R0,R3
	INC	@BUFPNT
	JMP	ATOD00

CATOH	CLR	R2
LOOP	MOV	@BUFPNT,R0
	CLR	R1
	MOVB	*R0,R1
	CI	R1,'0'*256
	JL	NOTHEX
	CI	R1,'9'*256
	JLE	GOTONE
	CI	R1,'A'*256
	JL	NOTHEX
	CI	R1,'F'*256
	JH	NOTHEX
	AI	R1,0900H
GOTONE	SLA	R1,4
	SRL	R1,12
	SLA	R2,4
	A	R1,R2
	INC	@BUFPNT
	JMP	LOOP
NOTHEX	MOV	R2,R1
	RET

;*******************************************************************
;	Error messages
;*******************************************************************
ERRMSG1	TEXT	'--Close error'
	BYTE	0DH,0AH,0
ERRMSG2	TEXT	'--Parse error'
	BYTE	0DH,0AH,0
ERRMSG3	TEXT	'--Make error'
	BYTE	0DH,0AH,0
ERRMSG4	TEXT	'--Write error'
	BYTE	0DH,0AH,0
ERRMSG5	TEXT	'--File too large error'
	BYTE	0DH,0AH,0
	EVEN

;*******************************************************************
;	PROCEDURE processing
;
;	A procedure is an ordinary text file whose directory type is PRO.
;	It is never loaded into memory: PFETCH reads it one 512-byte record
;	at a time and feeds the lines it assembles to DOCMD, exactly as if
;	they had been typed at the prompt.
;
;	ENTRY
;	  LOOK finds and opens the file, stores FSZ in MFSZ, reads FTY from
;	  the FCB and branches to DOPROC when it is PRO.
;
;	DOPROC - once per procedure
;	  - refuses to nest: PROCSW already set -> NESTERR
;	  - sets PROCSW.  This is what makes NEXTCMD fetch the next line
;	    from the file instead of prompting, and it is the switch that
;	    was never turned on before this version.
;	  - clears CRN, then saves the whole FCB to MNAM
;	  - copies MFSZ to PRECS
;	  - parses the invoking command line: -V and -N into VSW/NSW, then
;	    each remaining token into PBUF with a pointer in PPTRS
;
;	PFETCH / PLOOP - once per record
;	  - restores the FCB from MNAM.  Required: LOOK's PARSENAME and
;	    FOPEN, and any launched COM via FCB_PTR >00AC, all reuse the
;	    FCB at >0280 while the procedure is suspended.
;	  - SELDSK, SETDMA to PRBUF, RDSEQ.  BDOS advances CRN.  PRBUF is
;	    private: COMM_BUF is >0300, which INIT_LOADER overwrites with
;	    LOADERCODE before every launch.
;	  - saves the advanced FCB back to MNAM, refills MCNT and MADDR,
;	    decrements PRECS
;
;	BUFMOVE - once per character
;	  LF        discarded
;	  CR        ends the line -> PEOL
;	  EOF >FF   ends the procedure -> UNPROC
;	  PAD  >00  ends the procedure -> UNPROC
;	  SUBMARK $ sets SUBFLAG so the next character is a parameter
;	            reference -> PARMSUB
;
;	PEOL - once per assembled line
;	  ':' first    comment, line discarded
;	  '_' first    echo the line
;	  VSW set      echo every line (-V)
;	  NSW set      fetch but never execute (-N); with -V, a listing
;	  '__' first   WAIT: prompt and read a key.  CR continues, ^C ends
;	               the procedure, ^S sets SKIPSW and DOCMD discards the
;	               next line.
;	  otherwise -> DOCMD, which runs the line as though typed
;
;	EXIT
;	  UNPROC clears PROCSW and returns to the prompt.  Reached from
;	  EOF/PAD, from ^C at a WAIT, from PRECS reaching zero (PROCERR1),
;	  from a read error (via SHELLERR) and from every path through
;	  ERROUT - so any failing command inside a procedure ends it.
;*******************************************************************
PFETCH	LI	R4,CLSZ-1		; one byte held back for the terminator
	MOV	R4,@CMDBYTES
	LI	R4,CMDLINE
	MOV	R4,@CMDADDR
	CLR	@SUBFLAG
PLOOP	MOV	@MCNT,R4
	JNE	BUFMOVE
	MOV	@PRECS,R4
	JEQ	PROCERR1
	LI	R3,MNAM			; RESTORE THE PROCEDURE'S FCB - THE LAST
	LI	R4,FCB			; COMMAND WE RAN WILL HAVE CLOBBERED IT
	LI	R2,FCBSIZ
	CALL	@BMOVE
	LI	R3,DEFDRV
	LI	R2,SELDSK
	CALL	@BDOS
	LI	R3,PRBUF		; NOT COMM_BUF - INIT_LOADER COPIES
	LI	R2,SETDMA		; LOADERCODE OVER >0300 ON EVERY LAUNCH
	CALL	@BDOS
	LI	R3,FCB
	LI	R2,RDSEQ
	CALL	@BDOS
	MOV	R1,R1
	JLT	PROCERR0
	LI	R3,FCB			; SAVE THE CURSOR BDOS JUST ADVANCED
	LI	R4,MNAM
	LI	R2,FCBSIZ
	CALL	@BMOVE
	LI	R1,BLKSIZ
	MOV	R1,@MCNT
	LI	R4,PRBUF
	MOV	R4,@MADDR
	DEC	@PRECS
	JMP	BUFMOVE
PROCERR0	B	@SHELLERR
PROCERR1	B	@UNPROC

BUFMOVE	MOV	@MADDR,R4
	MOVB	*R4+,R1
	MOV	R4,@MADDR
	DEC	@MCNT
	DECT	SP
	MOV	R1,*SP
	MOV	@SUBFLAG,R0
	JNE	PARMSUB
	MOV	*SP+,R1
	CB	R1,@SUBMARK
	JNE	BUFMOV2
	SETO	@SUBFLAG
	JMP	PLOOP
BUFMOV2	CB	R1,@EOF
	JEQ	BUFMOV4
	CB	R1,@PAD
	JEQ	BUFMOV4
	CB	R1,@CPMEOF		; the file ends part way through a record and
	JEQ	BUFMOV4			; the rest is fill, not procedure text
BUFMOV3	CB	R1,@LF
	JEQ	PLOOP
BUFPUT	MOV	@CMDADDR,R4
	MOVB	R1,*R4
	CB	R1,@CR
	JNE	BUFPUT2
	INC	R4			; VIEW prints CMDLINE with OUTSTR, so the line
	CLR	R1			; needs a terminator after the CR.  The typed
	MOVB	R1,*R4			; path never needed one - it is never echoed.
	JMP	PEOL
BUFPUT2	INC	R4
	MOV	R4,@CMDADDR
	DEC	@CMDBYTES
	JEQ	MOVERR
	JMP	PLOOP
BUFMOV4	B	@UNPROC
MOVERR	B	@LINERR

PARMSUB	CLR	@SUBFLAG
	MOV	*SP+,R1
	DECT	SP
	MOV	R1,*SP
	SRL	R1,8
	AI	R1,0FFE0H
	JLT	NOSUB
	CI	R1,10
	JGT	NOSUB
	MOV	R1,R2
	MOV	*SP+,R1
	LI	R4,PPTRS
SUBLOOP	MOV	*R4,R3
	JEQ	NULLPARM
	DEC	R2
	JGT	SUBLOOP
SUBLOOP2	MOVB	*R3,R1
	CB	@SPACE,R1
	JLT	SUBDONE			; PLOOP is now beyond short-jump range
	INC	R3
	MOV	@CMDADDR,R4
	MOVB	R1,*R4+
	MOV	R4,@CMDADDR
	DEC	@CMDBYTES
	JEQ	LINERR
	JMP	SUBLOOP2
SUBDONE	B	@PLOOP			; trampoline for the jumps above
NOSUB	MOV	*SP+,R1
	JMP	BUFMOV2
NULLPARM	LI	R1,0A00H
	JMP	BUFMOV3

PEOL	MOVB	@CMDLINE,R1
	CB	@COMT,R1
	JEQ	BPFETCH
	CB	@NOTE,R1
	JEQ	VIEW
	MOV	@VSW,R1
	JEQ	CKNSW
VIEW	LI	R4,CMDLINE
	CALL	@OUTSTR
CKNSW	MOV	@NSW,R1
	JNE	BPFETCH
	MOVB	@CMDLINE,R1
	CB	@NOTE,R1
	JNE	BTDOCMD
	LI	R4,CMDLINE
	INC	R4
	CB	*R4,@NOTE
	JNE	BPFETCH
WAIT	LI	R4,WAITMSG
	CALL	@OUTSTR
	CLR	R1
	CALL	@CIN
	PUSH	R1
;	DECT	SP
;	MOV	R1,*SP
	MOVB	@CR,R3
	CALL	@OUTCHAR
;	MOV	*SP+,R1
	POP	R1
	CB	R1,@CR
	JEQ	BPFETCH
	CB	R1,@CTLC
	JEQ	UNPROC
	CB	R1,@CTLS
	JNE	WAIT
	SETO	@SKIPSW
BPFETCH	B	@PFETCH
BTDOCMD	B	@DOCMD

;*******************************************************************
;	Error output
;*******************************************************************
CMDERR	LI	R4,CMDLINE
	JMP	ERROUT
LINERR	MOV	@CR,R2
	LI	R4,LINEMSG
	JMP	ERROUT
PARMERR	LI	R4,PARMSG
	JMP	ERROUT
SHELLERR	LI	R4,SHELLMSG
	JMP	ERROUT
HARDERR	LI	R4,HARDMSG
	JMP	ERROUT
NULLERR	LI	R4,NULLMSG
	JMP	ERROUT
NESTERR	LI	R4,NESTMSG
	JMP	ERROUT
ERROUT:
	MESG	@QUESTMSG
	MESG	*R4
	MESG	@CRLF

UNPROC	CLR	@PROCSW
	LI	R4,CHKSYS
	INCT	R4
	MOVB	@SYSFILE,*R4
	B	@RETURN

DOPROC	MOV	@PROCSW,R1
	JNE	NESTERR
	SETO	R1
	MOV	R1,@PROCSW
	LI	R4,FCB			; DON'T ASSUME CRN IS VALID -
	CLR	@CRN(R4)		; SAME RESET LOAD DOES BEFORE ITS FIRST RDSEQ
	LI	R3,FCB
	LI	R4,MNAM
	LI	R2,FCBSIZ		; WHOLE FCB - CURSORS INCLUDED
	CALL	@BMOVE
	MOV	@MFSZ,@PRECS		; OUR OWN COUNT - L_FOUND REWRITES MFSZ
					; FOR EVERY COMMAND THE PROCEDURE RUNS
	CLR	R4
	MOV	R4,@MCNT
	CLR	@VSW
	CLR	@NSW
	LI	R4,PPTRS
	MOV	R4,@PPADDR
	LI	R3,PBUF
	LI	R4,CMDLINE
	LI	R2,10
	CLR	R0
PARSLOOP	CLR	R1
	MOVB	*R4+,R1
	CI	R1,2D00H
	JNE	PARS1
	MOV	R0,R0
	JNE	PARS0B
	INC	R4
	MOVB	*R4,R1
	DEC	R4
	CI	R1,2000H
	JH	PARS0B
	MOVB	*R4,R1
	CI	R1,5600H
	JNE	PARS0A
	MOV	R1,@VSW
PARS0	INC	R4
	JMP	PARSLOOP
PARS0A	CI	R1,4E00H
	JNE	PARS0B
	LI	R1,2D00H
	MOV	R1,@NSW
	JMP	PARS0
PARS0B	LI	R1,2D00H
PARS1	MOVB	R1,*R3+
	CI	R1,0D00H
	JEQ	PARSEND
	CI	R1,2000H
	JH	PARS2
	MOV	R0,R0
	JEQ	PARSLOOP
	CLR	R0
	JMP	PARSLOOP
PARS2	MOV	R0,R0
	JNE	PARSLOOP
	SETO	R0
	DEC	R2
	JLT	PARMERR
	DECT	SP
	MOV	R4,*SP
	DECT	SP
	MOV	R3,*SP
	DEC	R3
	MOVB	*R4,R1
	CI	R1,2000H
	JGT	PARS3
	CB	*R3,@NULPARM
	JNE	PARS3
	LI	R1,2000H
	MOVB	R1,*R3
PARS3	MOV	@PPADDR,R4
	MOV	R3,*R4+
	MOV	R4,@PPADDR
	MOV	*SP+,R3
	MOV	*SP+,R4
	JMP	PARSLOOP
PARSEND	CLR	@PPADDR
	B	@PFETCH

BMOVE	MOVB	*R3+,*R4+
	DEC	R2
	JNE	BMOVE
	RET

;*******************************************************************
;	Console I/O
;*******************************************************************
INCHAR	LI	R2,CIN
	CALL	@BDOS
	SWPB	R1
	RET

OUTCHAR	DECT	SP
	MOV	R3,*SP
	SWPB	R3
	LI	R2,COUT
	CALL	@BDOS
	MOV	*SP+,R3
	CB	R3,@CR
	JNE	OUT0
	MOVB	@LF,R3
	SWPB	R3
	LI	R2,COUT
	CALL	@BDOS
	LI	R3,0D0AH
OUT0	RET

OUTSTR	MOVB	*R4,R3
	JEQ	STR0
	INC	R4
	CALL	@OUTCHAR
	JMP	OUTSTR
STR0	RET

;*******************************************************************
;	Variables
;*******************************************************************
DBG_PTR		WORD	0
DBG_COUNT	WORD	0
DBG_DPTR	WORD	0
DBG_CHKADDR	WORD	0
DBG_DCOUNT	WORD	0
DBG_SAVE8	WORD	0
DBG_V0		WORD	0
DBG_V1		WORD	0
DBG_V2		WORD	0
DBG_V3		WORD	0
DBG_ON		WORD	0		;v6.4: non-zero = print the EXE block trace
DBG_LOG		BSS	1152		;144 records * 4 words * 2 bytes.
					;SIZED TO THE PHYSICAL MAXIMUM, not the current image:
					;each chain block carries 504 data bytes and the machine
					;maps at most 16 segs * 4K = 64K of image, so no EXE can
					;ever exceed 131 blocks. 144 covers that with margin.
					;History: 20 overflowed, then 80 overflowed at 96 blocks
					;(milestone 31 SKELTEST) -- the unbounded LDRBLK_E trace
					;writes ran 128 bytes past the log, over CMDADDR..LADDR,
					;the command buffer, and into DBG_OB/DBG_SP, which is why
					;the trace values printed but the separators were garbage.
					;DO NOT SHRINK. DUMP_EXE_TRACE clamps its print count to
					;144 as a second guard.
		EVEN
CMDADDR		WORD	0
CMDBYTES	WORD	0
DOSV		WORD	0
HDERRV		WORD	0
DOSERRV		WORD	0
PROCSW		WORD	0
SKIPSW		WORD	0
VSW		WORD	0
NSW		WORD	0
SUBFLAG		WORD	0
LADDR		WORD	0

VMENTRY		WORD	0
CMDLINE2	BYTE	0DH,00
		EVEN
		BSS	CLSZ
		EVEN

		EVEN
;	MNAM - full FCB save area for the running procedure.  Any command the
;	procedure runs reuses FCB at 0280, so PFETCH restores from here before
;	each read and saves the advanced cursor back afterwards.
MNAM		BSS	FCBSIZ
		EVEN
MFTY		WORD	0
EXTWALK		WORD	0		; EXT_TAB WALK POINTER (0 = EXPLICIT EXT)
;MSAVE		WORD	0				; R0 SAVE ACROSS BDOS IN L_TRY
MFSZ		WORD	0
PRECS		WORD	0		; RECORDS LEFT IN THE RUNNING PROCEDURE
;	PRBUF - the procedure engine's own sector buffer.  It cannot share
;	COMM_BUF: that is >0300, which INIT_LOADER overwrites with
;	LOADERCODE before every COM or EXE launch, and a procedure is
;	suspended across exactly those launches with a part-consumed record
;	still in the buffer.
PRBUF		BSS	BLKSIZ
		EVEN
		BSS	8
MCNT		WORD	0
MADDR		WORD	0

;*******************************************************************
;	Messages
;*******************************************************************
DBG_OB	TEXT	'['
	BYTE	0
	EVEN
DBG_SP	TEXT	' '
	BYTE	0
	EVEN
DBG_CB	TEXT	']'
	BYTE	0DH,0AH,0
	EVEN
DBG_BLK	TEXT	'BLK PG:'
	BYTE	0
	EVEN
DBG_SEP	TEXT	' '
	BYTE	0
	EVEN
DBG_NL	BYTE	0DH,0AH,0
	EVEN
;DBG_CHK	TEXT	'CHK:'
;	BYTE	0
;	EVEN
;DBG_CHKE	TEXT	'CHKE:'
;	BYTE	0
	EVEN

SINON	BYTE	0DH,0AH
	TEXT	'Shell Version 6.3'
	BYTE	0DH,0AH
	TEXT	'TMS99105 SBC V4 - Paged Memory'
	BYTE	0DH,0AH
NULLMSG	BYTE	0
	EVEN

QUESTMSG	TEXT	"?"
		BYTE	0
		EVEN
NESTMSG		TEXT	"Program name expected:"
		BYTE	0DH,00
		EVEN
SHELLMSG	TEXT	"Shell error:"
		BYTE	0DH,00H
		EVEN
RUBMSG		BYTE	08H,20H,08H,0
		EVEN
PARMSG		TEXT	"Too many parameters:"
		BYTE	0DH,00
		EVEN
LINEMSG		TEXT	"Line too long:"
		BYTE	0DH,00
		EVEN
HARDMSG		TEXT	"Hard disc error"
		BYTE	0DH,00
		EVEN
WAITMSG		TEXT	"--waiting..."
		BYTE	0
		EVEN

;*******************************************************************
;	INT2_HANDLER - Paged execution crash debug
;
;	Fires when an exception occurs in paged code.
;	Prints PC, WP, ST and the physical page mapped to the
;	faulting PC segment, then dumps all 16 map registers and
;	returns to monitor.
;*******************************************************************
;INT2_HANDLER:
;	MESG	@TXT_INT2PC
;	WHEX	R14			;PC AT EXCEPTION
;	MESG	@TXT_INT2WP
;	WHEX	R13			;WORKSPACE POINTER
;	MESG	@TXT_INT2ST
;	WHEX	R15			;STATUS REGISTER
;	PSEL_DIS			;DISABLE PSEL BEFORE READING MAP REGISTERS

	;--- READ PAGE REGISTER FOR THE SEGMENT CONTAINING FAULT PC ---
;	MOV	R14,R8			;R8 = FAULT PC
;	SRL	R8,12			;R8 = VIRTUAL SEGMENT (0-15)
;	LI	R12,MAP_WIN_BASE
;	SLA	R8,1			;2 CRU BITS PER MAP REGISTER
;	A	R8,R12			;R12 = THIS SEGMENT'S MAP REGISTER
;	CLR	R1
;	STCR	R1,BYTEWIDE
;	SRL	R1,14			;PAGE NUMBER -> LOW BITS
;	MESG	@TXT_INT2PAGE
;	WHEX	R1
;	MESG	@TXT_INT2NL

;	MESG	@TXT_INT2MAP
;	LI	R12,MAP_WIN_BASE
;	CLR	R8
;INT2_ML:
;	CLR	R1
;	STCR	R1,BYTEWIDE
;	SRL	R1,14
;	WHEX	R1
;	LI	R0,2000H
;	WRITE	R0
;	INCT	R12
;	INC	R8
;	CI	R8,16
;	JL	INT2_ML
;	MESG	@TXT_INT2NL
;	B	@0F004H

;TXT_INT2PC:	TEXT	'INT2 PC:'
;		BYTE	0
;		EVEN
;TXT_INT2WP:	TEXT	' WP:'
;		BYTE	0
;		EVEN
;TXT_INT2ST:	TEXT	' ST:'
;		BYTE	0
;		EVEN
;TXT_INT2PAGE:	TEXT	' PAGE:'
;		BYTE	0
;		EVEN
;TXT_INT2MAP:	TEXT	'MAP:'
;		BYTE	0
;		EVEN
;TXT_INT2NL:	BYTE	0DH,0AH,0
		EVEN

;*******************************************************************
;	MAP_INIT - clear all 16 map registers to page 0
;	Entry: none  Exit: R0=0, R1=0, R12=MAP_WIN_BASE+32
;	Called at shell cold start and LOADERCODE entry.
;*******************************************************************
MAP_INIT:	CLR	R15
	LST	R15
	LI	R12,MAP_WIN_BASE
	CLR	R0
	LI	R1,NUM_MAP_ENTRIES
MAPI_L:	LDCR	R0,BYTEWIDE
	INCT	R12
	DEC	R1
	JNE	MAPI_L
	RT

;*******************************************************************
;	MAP_SET - program one 6116 map register
;	Entry: R9=segment (0-15), R0=page (0-3)
;	Exit:  R9 clobbered (segment*2), R0 clobbered, R12=CRU addr
;	Note:  R8 is safe - use R8 to preserve values across MAP_SET
;*******************************************************************
MAP_SET:
	LI	R12,MAP_WIN_BASE
	SLA	R9,1			;SEGMENT * 2 = CRU BIT OFFSET
	A	R9,R12
	SLA	R0,8			;MOVE PAGE TO HIGH BYTE (LDCR BYTE TRANSFER USES HIGH BYTE)
	LDCR	R0,BYTEWIDE
	RT

PPTRS	BSS	22
PBUF	BSS	64
PPADDR	WORD	0

	END
