;*******************************************************************
;
;  TMS99105 SBC V4 - Memory Map
;
;  Address   Label      Purpose
;  >0230     SH_WP      Shell Workspace: R0-R15
;  >0250     SH_CMD     Command Line: raw input string
;  >0280     CM_FCB     FCB (36 bytes)
;  >02A4     CM_VARS    Bridge Variables: pointers, status flags
;  >0300     CM_BUF     512-byte Sector Buffer / LOADERCODE area
;
;  Paged Memory Model (Rev 24Q hardware):
;  Segment 0  (>0000->0FFF) COMMON - forced physical page 0
;  Segments 1-E (>1000->EFFF) PAGED - selected by 6116 map registers
;  Segment F  (>F000->FFFF) ROM - forced physical page 0
;
;  6116 mapper programmed via CRU (LDCR/STCR) at MAP_WIN_BASE.
;  PSEL XOPs enable/disable the GAL page-select output.
;
;  V6.3 raw-COM contract:
;    C and D run on physical page 1 while the application executes.
;    Application BDOS calls pass through a COMMON gateway which disables
;    PSEL for the complete BDOS call, then restores PSEL before RET.
;
;  V6.3 command lookup and procedure contract:
;    A bare command name resolves through EXEC_TAB (COM, EXE, PRO) in
;    precedence order.  An explicitly typed extension is used as typed.
;    File type comes from the directory entry (FTY, FCB offset 11), not
;    from the extension.
;    FTY = PRO is INTERPRETED, not loaded - see PROCEDURE processing.
;
;*******************************************************************
;
;  Original Version:
;  Small/Shell 1.0 - A command processor for North Star DOS
;  Copyright 1981 J.E. Hendrix, All rights reserved
;  Written for PDS assembler
;
;  TMS9900 Port and Modern Revisions:
;
;  4.0   Initial TMS9900 version
;  4.1   Filename extension handling (4 June 2010)
;  4.6   Internal commands: DIR, SAVE, ERA
;  4.7   Multisegment alignment; RETURN changed to RETF
;  4.9   Intermediate paging work
;
;  5.4   Paged memory loader - first working version
;        Transparent GAL mapping - no trampolines, no LDS/LDD
;        LOADERCODE replaced with link99 v3.9 page map loader
;        Sentinel detection: FFFF FFFF FFFF at file offset 6
;        COM/EXE go direct to LOADERCODE (no pre-read)
;        MAP_INIT called at shell entry and LOADERCODE entry
;        .FILENAME load-only restored (reads flat, returns to prompt)
;        R8 saves launch address across LDRCPY walk
;        LDRRUN_F for raw/flat binaries
;
;  5.5   Paged memory loader - production version (June 2026)
;  5.8   Fix EXE reload: read two sectors on staging overflow to match
;        initial load. One-sector reload caused page 3 data corruption
;        for EXE files larger than two sectors (> 1024 bytes).
;        MAP_SET/MAP_INIT getter-setter pattern established
;        LDRSEG calls MAP_SET - no inline CRU bit manipulation
;        R8 saved in LDRPM before MAP_SET clobbers R9
;  6.3   Raw COM C/D private-page execution.
;        COMMON >02E8 launch gate: PSEL_EN / B *R8.
;        COMMON >02F0 return gate: PSEL_DIS / B @RETURN.
;        COMMON >02F6 BDOS gate: PSEL_DIS / CALL @BDOS / PSEL_EN / RET.
;        RETURN explicitly restores C=0,D=0 before MAP_INIT.
;        Proven with repeated XMODEM and R99 TEST H- through full return.
;
;        Command lookup rewritten (September 2026).  A bare name used to
;        get extension '???', so SEARCH1 returned the first directory
;        entry of that name whatever its type - typing HELLO ran
;        HELLO.R99 instead of HELLO.COM and branched into an object
;        file.  LOOK now walks EXEC_TAB.  The retry loop it replaces was
;        already written for a table walk but was reading address >3F00.
;        File type read from FCB+FTY at L_FOUND.  SET_FTY retained but
;        unused: its codes are positional over EXT_TAB (BAS=3, BAT=4)
;        and disagree with the BDOS (TXT=3, BAS=4, PRO=5).
;
;        Procedure processing connected.  DOPROC had never been called
;        from anywhere, so PROCSW was never set, NEXTCMD always chose
;        PROMPT and the whole PFETCH engine was unreachable.
;        PROC_FCB provides dedicated engine workspace, decoupling it from CM_FCB.
;        PRECS added: the engine's own record countdown.  MFSZ cannot
;        serve, L_FOUND rewrites it for every command a procedure runs.
;        DOPROC clears CRN, as LOAD does before its first RDSEQ.
;
;  6.1a  DBG_LOG 80->144 records (1152 bytes): 96-block EXE (M31)
;        overflowed the 80-record log into shell variables and the
;        trace separator strings. 144 = provable max (64K/504+margin).
;        DUMP_EXE_TRACE clamps to 144. Loader code path unchanged.
;  6.0   LDRHDR_RL: save/restore R0 (page) and R2 (start) across its
;        own BDOS calls -- both were live, already-decoded header
;        fields when called from LDRB2/LDRB3, but neither was
;        preserved before.
;        LDRCHAIN_E: between-block sector fetch now checks both
;        reads for real EOF instead of always assuming 2 full
;        sectors are valid -- was reading stale/garbage bytes as a
;        header when a file's true end landed inside this fetch.
;        Multi-sector loading: LDRSEC direct DMA to paged memory
;        BDOS passes DMA address unchanged through page mapper
;        INT2_HANDLER: full debug dump (PC/WP/ST + map registers)
;        INT2_VEC installed before every paged launch
;        Paged execution confirmed: HELLO runs from seg 2 page 2
;        Transparent memory model: XOPs safe from paged code
;        Segment 0 COMMON always page 0 - workspace always visible
;
;*******************************************************************

R0	EQU	0
R1	EQU	1
R2	EQU	2
R3	EQU	3
R4	EQU	4
R5	EQU	5
R6	EQU	6
R7	EQU	7
R8	EQU	8
R9	EQU	9
;R10	EQU	10
R11	EQU	11
R12	EQU	12
WP	EQU	13
R13	EQU	13
R14	EQU	14
R15	EQU	15
SP	EQU	10
;
;----Define  Extended Operations
;
	DXOP	PSEL_DIS, 0
	DXOP	PSEL_EN, 1
;	DXOP	PUSHREG,4
;	DXOP	POPREG,5
	DXOP	CALL,6
	DXOP	RET,7
	DXOP	PUSH,8
	DXOP	POP,9
	DXOP	WHEX,10			;WRITE OUT A 16 BIT HEX VALUE
	DXOP	RHEX,11			;READ IN A 16 BIT HEX VALUE
	DXOP	WRITE,12		;WRITE CHAR IN MSB
	DXOP	READ,13			;READ CHAR IN MSB
	DXOP	MESG,14			;OUTPUT NULL TERMINATED MESSAGE
	DXOP	DEBUG,15
;
; OPERATING SYSTEM EQUATES
;
SHELL:	EQU	0C000H
BDOS:	EQU	0E000H
MONITOR:	EQU	0F000H
BANNER:	EQU	MONITOR + 4

MAP_WIN_BASE:	 EQU	080C0H		;6116 MAP REGISTER CRU BASE
NUM_MAP_ENTRIES: EQU	16		;16 PAGE REGISTERS

;
; WORKSPACE AND MEMORY LAYOUT
;
WORKSP:	EQU	0230H		;SHELL WORKSPACE
STACKP:	EQU	0FFEH		;STACK AT 0x1000, GROWS DOWN
TPA:	EQU	0500H		;DEFAULT LOAD ADDRESS
CMDLINE:	EQU	0250H
HALT:	EQU	10FFH
COMM_BUF:	EQU	0300H		;COMMON BUFFER / LOADERCODE AREA
COMM_FCB:	EQU	0280H
FCB:	EQU	COMM_FCB
;
; SHELL ENTRY POINT
;


	AORG	SHELL
	LWPI	WORKSP

	LI	SP,STACKP
	BL	@MAP_INIT		;CLEAR ALL MAP REGISTERS TO PAGE 0
	B	@INIT
;
; LOW MEMORY EQUATES
;
CMDL_PTR:	EQU	0A0H
CMDL_SIZE:	EQU	0A2H
BUFF_PTR:	EQU	0A4H
LBA:		EQU	0A8H
FCB_PTR:	EQU	0ACH
FREEMEM:	EQU	0A6H
MEMLIMIT:	EQU	0B0H
BUFFSIZ:	EQU	512
;
SHELL_PTR:	EQU	80H
BDOS_PTR:	EQU	84H
LOADER:		EQU	0300H
CLSZ:		EQU	64
BYTSEC:		EQU	512
BYTEWIDE:	EQU	2			;BYTE-PARALLEL CRU TRANSFER WIDTH
NUM_SEGS:	EQU	16			;NUMBER OF MAP SEGMENTS
PROT_SEG:	EQU	12			;FIRST PROTECTED SEGMENT
SEG_SIZE:	EQU	1000H			;4KB SEGMENT SIZE
;PSEL_EN:	EQU	0100H			;PSEL ENABLE VALUE
INT2_VEC:	EQU	000AH			;INT2 VECTOR ADDRESS
STAGING:	EQU	0500H			;SECTOR STAGING BUFFER
;--- OVERLAY MANAGER PAGE VARIABLES (0x02A0-0x02FF) ---
OVL_PRINT_VEC:	EQU	02A0H			;WORD: PRINT CALLBACK ADDRESS
OVL_COUNT:	EQU	02A2H			;WORD: NUMBER OF OVERLAYS LOADED
OVL_PAGE_TAB:	EQU	02A4H			;16 WORDS: PHYSICAL PAGE FOR OVERLAY ID 1-16
OVL_SEG_TAB:	EQU	02C4H			;16 WORDS: VIRTUAL SEGMENT FOR OVERLAY ID 1-16
OVL_CURR_ID:	EQU	02E4H			;WORD: CURRENTLY MAPPED OVERLAY ID (0=NONE)
OVL_CURR_SEG:	EQU	02E6H			;WORD: CURRENTLY MAPPED SEGMENT
FLATBASE:	EQU	1000H			;DEFAULT FLAT LOAD ADDRESS
LGATE:		EQU	02E8H			;COM launch gate (4 bytes)
RGATE:		EQU	02F0H			;COM return gate (6 bytes)
BGATE:		EQU	02F6H			;application BDOS gate (10 bytes)
APAGE:		EQU	1			;private COM physical page
SEGC:		EQU	12			;logical segment C
SEGD:		EQU	13			;logical segment D

IDE_BYTSEC:	EQU	256

; BDOS FUNCTION CODES
CIN	EQU	1
COUT	EQU	2
SELDSK	EQU	14
RDSEQ	EQU	20
FOPEN	EQU	15
FCLOSE	EQU	16
SEARCH1	EQU	17
SEARCH2	EQU	18
ERAFIL	EQU	19
WRSEQ	EQU	21
MAKFIL	EQU	22
SETDMA	EQU	26
FMKDIR	EQU	41		; BDOS 6.0 Make Directory
FCHDIR	EQU	42		; BDOS 6.0 Change Directory
;
; FCB OFFSETS
;
FCBSIZ	EQU	36
NAM	EQU	0
FTY	EQU	11
FLA	EQU	16
CRN	EQU	26
CBN	EQU	24
RELB	EQU	28
RELR	EQU	30
FSB	EQU	12
FSZ	EQU	14
;
; FILE TYPES
;
SYS	EQU	0
COM	EQU	1
EXE	EQU	2
TXT	EQU	3
BAS	EQU	4
PRO	EQU	5
;
; ASSEMBLY CONSTANTS
;
BLKSIZ	EQU	512
NAMSIZ	EQU	11
EXTSIZ	EQU	3
DDEN	EQU	1
DCOMR	EQU	1
PAD	EQU	0
EXTOFF	EQU	NAMSIZ-EXTSIZ
CTLC	BYTE	03H
CTLX	BYTE	18H
CTLS	BYTE	13H
CTLY	BYTE	19H
CTLZ	BYTE	1AH
SPACE	BYTE	20H
	BYTE	0
BS	BYTE	08H
CR	BYTE	0DH
LF	BYTE	0AH
DEL	BYTE	07H
EOF	BYTE	0FFH
CPMEOF	BYTE	01AH			; ^Z - what fills the tail of the last record
COMT	BYTE	3AH
JUMP	BYTE	'.'
NULPARM	BYTE	'.'
EXT	BYTE	'.'
NOTE	BYTE	'_'
PROM	BYTE	'%'
SUBMARK	BYTE	'$'
SYSFILE	BYTE	'*'
DOSCMD	BYTE	'+'
CONSOLE	EQU	0
DEFDRV	EQU	0
	EVEN

;*******************************************************************
;	INIT - cold start initialisation
;*******************************************************************
	EVEN
INIT	LWPI	WORKSP
	LI	SP,STACKP

	;--- INIT OVERLAY MANAGER VARIABLES ---
	CLR	R0
	MOV	R0,@OVL_COUNT
	MOV	R0,@OVL_CURR_ID
	MOV	R0,@OVL_CURR_SEG

	LI	R1,CMDLINE
	LI	R2,CMDLINE2
CMDLOOP:	MOVB	*R2+,*R1+
	JNE	CMDLOOP

	MOVB	@CR,@CMDLINE
	LI	R0,CMDLINE
	MOV	R0,@CMDL_PTR
	CLR	@CMDL_SIZE
	LI	R0,COMM_BUF
	MOV	R0,@BUFF_PTR
	LI	R0,COMM_FCB
	MOV	R0,@FCB_PTR

INIT22
	; Install the mapped-COM launch gate at COMMON >02E8.
	LI	R1,LSRC
	LI	R2,LGATE
LGCP:	MOV	*R1+,*R2+
	CI	R1,LEND
	JL	LGCP

	; Install the mapped-COM return gate at COMMON >02F0.
	LI	R1,RSRC
	LI	R2,RGATE
RGCP:	MOV	*R1+,*R2+
	CI	R1,REND
	JL	RGCP

	; Install the application BDOS gate at COMMON >02F6.
	LI	R1,BSRC
	LI	R2,BGATE
BGCP:	MOV	*R1+,*R2+
	CI	R1,BEND
	JL	BGCP

	; SHELL_PTR: B @RGATE
	LI	R0,0460H
	LI	R1,RGATE
	MOV	R0,@SHELL_PTR
	MOV	R1,@SHELL_PTR+2

	; BDOS_PTR: B @BGATE
	LI	R0,0460H
	LI	R1,BGATE
	MOV	R0,@BDOS_PTR
	MOV	R1,@BDOS_PTR+2

	LI	R0,TPA
	MOV	R0,@FREEMEM
	LI	R0,SHELL
	MOV	R0,@MEMLIMIT

;--- FORCE ROOT DIRECTORY ON COLD BOOT ---
	LI	R4,FCB
	LI	R2,11
INIT_RT:	MOVB	@SPACE,*R4+
	DEC	R2
	JNE	INIT_RT
	LI	R2,FCHDIR
	LI	R3,FCB
	CALL	@BDOS
	; ---------------------------------------

	MESG	@SINON

;*******************************************************************
;	DOCMD - process next shell command
;*******************************************************************
DOCMD	MOV	@SKIPSW,R0
	CLR	@SKIPSW
	MOV	R0,R0
	JNE	DOCMD2A
	LI	R3,CMDLINE
	CLR	R1
	MOVB	*R3,R1
	CB	R1,@CR
	JEQ	DOCMD2A

CHKSYS	CI	R1,0
	JNE	DOCMD1
	B	@CMDERR

DOCMD1	CB	R1,@CTLX
	JNE	DOCMDAA
	BLWP	@BANNER
DOCMDAA	CB	R1,@CTLY
	JNE	DOCMD2

DOCMD2	CB	R1,@SPACE
	JH	DOCMD4

DOCMD2A	B	@NEXTCMD

DOCMD4	CB	R1,@JUMP
	JNE	DOCMD3
	LI	R3,CMDLINE+1
	CB	*R3,@SPACE
	JH	LOOK
	B	@GOPROG

DOCMD3	CB	R1,@DOSCMD
	JNE	LOOK
DOCMD9	B	@RETURN

;*******************************************************************
;	LOOK - look up named file (with Root Fallback support)
;*******************************************************************
LOOK:	CLR	@FB_FLAG		; Reset fallback flag on new lookup

	; ---> PREVENT STICKY ROOT OVERRIDE
	; Force target byte to space so BDOS defaults to CFLD for the local search
	MOVB	@SPACE,@FCB+18

	CALL	@PARSENAME
	CALL	@ICMD
	CALL	@SEG_SWITCH
;CHECK IF JUST FILE NAME TYPED IN
	CLR	@EXTWALK		; 0 = EXPLICIT EXTENSION, NO WALK
	CB	@FCB+EXTOFF,@SPACE
	JNE	L_START
;NO EXTENSION TYPED - WALK EXEC_TAB IN ORDER: COM, EXE, PRO
	LI	R0,EXEC_TAB
	MOV	R0,@EXTWALK

L_TRY:	MOV	@EXTWALK,R0
	MOVB	*R0,R1		; FIRST BYTE OF TABLE ENTRY
	JEQ	LOOK_FB_CHK	; END OF LOCAL TABLE -> CHECK ROOT FALLBACK
	LI	R4,FCB+EXTOFF
	MOVB	*R0+,*R4+
	MOVB	*R0+,*R4+
	MOVB	*R0,*R4

L_START:	LI	R3,FCB
	LI	R2,SEARCH1
	CALL	@BDOS
	MOV	R1,R1
	JLT	L_RETRY
	JMP	L_FOUND

L_RETRY	MOV	@EXTWALK,R0	; WAS THIS A WILDCARD WALK?
	JEQ	LOOK_FB_CHK	; NO - EXPLICIT EXTENSION FAILED -> CHECK ROOT FALLBACK
	AI	R0,3		; NEXT TABLE ENTRY
	MOV	R0,@EXTWALK
	JMP	L_TRY

LOOK_FB_CHK:
	MOV	@FB_FLAG,R0
	JNE	LOOKERR		; Already tried root fallback, truly not found

	SETO	@FB_FLAG		; Mark that we are trying root fallback

	; --- CLEVER BDOS FALLBACK ---
	; Tell BDOS to specifically target the Root directory (ID 0)
	; for this specific search, without changing our actual working directory.

	CLR	R0
	MOVB	R0,@FCB+18		; Poke 0 (Root) into the FCB target byte

	; Restart extension walk / lookup in root
	MOV	@EXTWALK,R0		; Check pointer: was this a wildcard walk? (0 = explicit)
	JEQ	FB_EXPR			; If explicit, just jump straight to search
	LI	R0,EXEC_TAB		; If implicit, restart the extension table from the top
	MOV	R0,@EXTWALK
	JMP	L_TRY
FB_EXPR:
	JMP	L_START

LOOKERR:	B	@CMDERR

L_FOUND:
	LI	R2,FOPEN
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	LOOKERR

L_FND_OK:
	LI	R4,FCB
	MOV	@FSZ(R4),@MFSZ
	MOVB	@FTY(R4),R1		; FILE TYPE FROM DIRECTORY ENTRY
	MOVB	R1,@MFTY		; KEEP FOR LOAD1
	SRL	R1,8
	CI	R1,PRO
	JEQ	L_PROC			; PROCEDURE FILE - INTERPRET, DON'T LOAD
	B	@LOAD
L_PROC:	B	@DOPROC

;****************5***************************************************
;	PADSPACE - R2=count, R4=destination
;*******************************************************************
PADSPACE:	MOV	R2,R2
	JLE	PADRETS
PADLOOP:	MOVB	@SPACE,*R4+
	DEC	R2
	JH	PADLOOP
PADRETS:	RET

;*******************************************************************
;	CHKCHAR - check if char at *R3 is valid filename char
;*******************************************************************
CHKCHAR:	MOVB	*R3,R1
	SRL	R1,8
	CI	R1,'0'
	JL	INVALID
	CI	R1,'9'
	JLE	VALID
	ANDI	R1,00DFH
	AI	R1,-'A'
	CI	R1,001AH
	JH	INVALID
VALID:	CLR	R1
	JMP	SETFLAG
INVALID:	LI	R1,1
SETFLAG:	MOV	R1,R1
	RET

;*******************************************************************
;	SEG_SWITCH - deprecated v5.4 (transparent GAL mapping)
;*******************************************************************
SEG_SWITCH:	RET

SSWERR:	B	@PARSERR

;*******************************************************************
;	PARSENAME - parse filename from command line into FCB
;*******************************************************************
PARSENAME:
	MOVB	@SPACE,@FCB+18		; <--- Reset sticky folder override
	LI	R4,FCB
	LI	R2,NAMSIZ - EXTSIZ
	CLR	R0

PARSE1:	CALL	@CHKCHAR
	JNE	FILLNAME
	MOVB	*R3+,*R4+
	DEC	R2
	JEQ	FINDDOT
	JMP	PARSE1

FILLNAME:	CALL	@PADSPACE

FINDDOT:	CB	*R3+,@EXT
	JEQ	GETEXT
	DEC	R3
	LI	R2,EXTSIZ
	LI	R4,FCB + NAMSIZ - EXTSIZ
	CALL	@PADSPACE
	RET

EXT_TAB:	TEXT	'COM'
	TEXT	'EXE'
	TEXT	'BAS'
	TEXT	'BAT'
EXT_END:	BYTE	0
	EVEN

EXEC_TAB:	TEXT	'COM'
	TEXT	'EXE'
	TEXT	'PRO'
EXEC_END:	BYTE	0
	EVEN

GETEXT:	LI	R2,EXTSIZ
	LI	R4,FCB + NAMSIZ - EXTSIZ
NEXTEXT:	CALL	@CHKCHAR
	JNE	FILLEXT
	MOVB	*R3+,R1
	MOV	R1,R0
	SRL	R0,8
	CI	R0,'A'
	JL	EXTSTORE
	CI	R0,'Z'
	JLE	EXTSTORE
	CI	R0,'a'
	JL	EXTSTORE
	CI	R0,'z'
	JH	EXTSTORE
	ANDI	R1,0DF00H		;uppercase letters only
EXTSTORE:
	MOVB	R1,*R4+
	DEC	R2
	JEQ	FILLEXT
	JMP	NEXTEXT
FILLEXT:
	B	@PADSPACE		; Use standard Space padding instead of Nulls!

;*******************************************************************
;	SET_FTY - derive file type from FCB extension, store in MFTY
;*******************************************************************
SET_FTY:
	LI	R5,EXT_TAB			; TABLE BASE
	CLR	R7				; TYPE CODE (0=SYS)
SFTY_LOOP:
	MOV	R5,R6				; R6 = ENTRY WALK POINTER
	MOVB	*R6+,R0				; BYTE 1
	JEQ	SFTY_NONE			; END OF TABLE
	INC	R7				; NEXT TYPE CODE
	CB	R0,@FCB+EXTOFF			; COMPARE BYTE 1
	JNE	SFTY_NEXT
	MOVB	*R6+,R0				; BYTE 2
	CB	R0,@FCB+EXTOFF+1		; COMPARE BYTE 2
	JNE	SFTY_NEXT
	MOVB	*R6,R0				; BYTE 3
	CB	R0,@FCB+EXTOFF+2		; COMPARE BYTE 3
	JEQ	SFTY_FOUND
SFTY_NEXT:
	AI	R5,3				; NEXT ENTRY
	JMP	SFTY_LOOP
SFTY_NONE:
	CLR	R7				; NO MATCH - SYS=0
SFTY_FOUND:
	SWPB	R7				; TYPE TO HIGH BYTE FOR MOVB
	MOVB	R7,@MFTY			; STORE TYPE CODE
	RET

;*******************************************************************
;	LOAD - load executable file
;*******************************************************************
LOAD:	CLR	R1
	MOVB	R1,@CMDLINE-2
	LI	R4,FCB
	MOV	@FLA(R4),R3
	JNE	LOAD2
	LI	R3,TPA		;DEFAULT FOR NON EXE OR COM FILES ETC
LOAD2	MOV	R3,@LADDR
	CLR	@CRN(R4)

	CB	@CMDLINE,@JUMP
	JNE	LOADRUN
LOADF3	DECT	SP
	MOV	R3,*SP
LOADF0	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	MOV	*SP+,R3
	CI	R1,-1
	JEQ	LOADF1
	AI	R3,BLKSIZ
	JMP	LOADF3
LOADF1
	MOV	R3,@FREEMEM
	B	@NEXTCMD

LOADRUN:
	MOVB	@FTY(R4),R1
	SRL	R1,8
	CI	R1,COM
	JNE	LT2
	B	@GOPROG
LT2	CI	R1,EXE
	JNE	LT3
	B	@GOPROG_EXE		;EXE - PAGED CHAIN FORMAT

LT3	CI	R1,0
	JNE	LT4
	B	@GOPROG
LT4
	CLR	@CRN(R4)
LOAD3	DECT	SP
	MOV	R3,*SP
LOAD0	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	MOV	*SP+,R3
	CI	R1,-1
	JEQ	LOAD1
	AI	R3,BLKSIZ
	JMP	LOAD3
LOAD1	MOV	R3,@FREEMEM

	MOVB	@MFTY,R1
	SRL	R1,8
	CI	R1,PRO
	JNE	LOAD1B
	B	@NEXTCMD
LOAD1B	CI	R1,TXT
	JNE	LOAD1C
	B	@NEXTCMD
LOAD1C	B	@NEXTCMD

;*******************************************************************
;	GOPROG - run loaded program via LOADERCODE
;*******************************************************************
GOPROG	LI	R4,CMDLINE
GOLOOP	INC	R4
	CB	*R4,@SPACE
	JH	GOLOOP
	CLR	R1
	MOVB	R1,@CMDLINE-1
	LI	R0,SHELL_PTR
	DECT	SP
	MOV	R0,*SP
	CALL	@INIT_LOADER
	B	@LOADER

;*******************************************************************
;	INIT_LOADER - copy LOADERCODE to LOADER (0x0300)
;*******************************************************************
INIT_LOADER:	LI	R2,LOADER
	LI	R1,LOADERCODE
IL0:	MOV	*R1+,*R2+
	CI	R1,END_LOADER
	JL	IL0
	RET

;*******************************************************************
;	GOPROG_EXE - run EXE (paged chain format) via LOADERCODE_EXE
;*******************************************************************
GOPROG_EXE:
	CALL	@DBG_SWSCAN		;v6.4: consume a "-D" switch, set DBG_ON
	LI	R4,CMDLINE
GOLOOP_E:
	INC	R4
	CB	*R4,@SPACE
	JH	GOLOOP_E
	CLR	R1
	MOVB	R1,@CMDLINE-1
	LI	R0,SHELL_PTR
	DECT	SP
	MOV	R0,*SP
	CALL	@INIT_LOADER_EXE
	B	@LOADER

;*******************************************************************
;	INIT_LOADER_EXE - copy LOADERCODE_EXE to LOADER (0x0300)
;*******************************************************************
INIT_LOADER_EXE:
	LI	R2,LOADER
	LI	R1,LOADERCODE_EXE
ILE0:	MOV	*R1+,*R2+
	CI	R1,END_LOADER_EXE
	JL	ILE0
	RET

;****************5***************************************************
;  LOADERCODE_EXE v6.0 (Integrated Fixes)
;*******************************************************************
LOADERCODE_EXE:
	LI	R12,MAP_WIN_BASE
	CLR	R0
	LI	R1,NUM_SEGS
LDRCL_E:
	LDCR	R0,BYTEWIDE
	INCT	R12
	DEC	R1
	JNE	LDRCL_E

	CLR	@DBG_COUNT
	LI	R9,DBG_LOG
	MOV	R9,@DBG_PTR
	CLR	R0
	LI	R3,0500H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JNE	LDREDET_E
	B	@LDRRUN

LDREDET_E:
	MOV	R1,R1
	JLT	LDRERR_B
	JMP	LDREDET_OK
LDRERR_B:
	B	@LDRERR

LDREDET_OK:
	LI	R3,0700H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS

	LI	R6,0500H
	LI	R4,0900H
	CLR	R8

LDRBLK_E:
	MOV	R6,R7
	MOV	*R6+,R5
	C	R6,R4
	JNE	LDRB1
	CALL	@LDRHDR_RL
LDRB1:
	MOV	*R6+,R0
	C	R6,R4
	JNE	LDRB2
	CALL	@LDRHDR_RL
LDRB2:
	MOV	*R6+,R2
	C	R6,R4
	JNE	LDRB3
	CALL	@LDRHDR_RL
LDRB3:
	MOV	*R6+,R3

	MOV	@DBG_PTR,R9
	MOV	R0,*R9+
	MOV	R2,*R9+
	MOV	R3,*R9+
	MOV	R5,*R9+
	MOV	R9,@DBG_PTR
	INC	@DBG_COUNT

	MOV	R8,R8
	JNE	LDRMAP_E
	MOV	R2,R8

LDRMAP_E:
	MOV	R0,R0
	JEQ	LDRCPY_E
	MOV	R2,R9
	SRL	R9,12
	BL	@MAP_SET

LDRCPY_E:
	MOV	R2,@DBG_CHKADDR
	PSEL_EN
LDRCPYB_E:
	MOVB	*R6+,*R2+
	DEC	R3
	JEQ	LDRDONE_E
	C	R6,R4
	JL	LDRCPYB_E

LDRSEC_E:
	PSEL_DIS
	PUSH	R8
	PUSH	R7
	PUSH 	R5
	PUSH	R3
	PUSH	R2
	LI	R3,0500H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JEQ	LDRSEC_E_NONE
	LI	R3,0700H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JEQ	LDRSEC_E_HALF
	LI	R0,0900H
	JMP	LDRSEC_E_RESTORE
LDRSEC_E_HALF:
	LI	R0,0700H
	JMP	LDRSEC_E_RESTORE
LDRSEC_E_NONE:
	CLR	R0
LDRSEC_E_RESTORE:
	MOV	*SP+,R2
	MOV	*SP+,R3
	MOV	*SP+,R5
	MOV	*SP+,R7
	MOV	*SP+,R8
	MOV	R0,R0
	JEQ	LDRSEC_E_DONE
	PSEL_EN
	LI	R6,0500H
	MOV	R0,R4
	JMP	LDRCPYB_E
LDRSEC_E_DONE:
	B	@LDRRUN

LDRDONE_E:
	PSEL_DIS
	MOV	R5,R5
	JNE	LDRCHAIN_E
	B	@LDRRUN

LDRCHAIN_E:
	A	R5,R7
	MOV	R7,R6
	C	R6,R4
	JHE	LDRCHAIN_FAR
	B	@LDRBLK_E
LDRCHAIN_FAR:
	DECT	SP
	MOV	R8,*SP
	LI	R3,0500H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JEQ	LDRCH_NONE
	LI	R3,0700H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JEQ	LDRCH_HALF
	LI	R0,0900H
	JMP	LDRCH_RST
LDRCH_HALF:
	LI	R0,0700H
	JMP	LDRCH_RST
LDRCH_NONE:
	CLR	R0
LDRCH_RST:
	MOV	*SP+,R8
	MOV	R0,R0
	JEQ	LDRCH_DONE
	LI	R6,0500H
	MOV	R0,R4
	B	@LDRBLK_E
LDRCH_DONE:
	B	@LDRRUN

LDRHDR_RL:
	PSEL_DIS
	PUSH	R8
	PUSH	R5
	PUSH	R2
	PUSH	R0
	LI	R3,0500H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JEQ	LDRHD_EOF
	LI	R3,0700H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
LDRHD_EOF:
	MOV	*SP+,R0
	MOV	*SP+,R2
	MOV	*SP+,R5
	MOV	*SP+,R8
	LI	R6,0500H
	LI	R4,0900H
	RET

END_LOADER_EXE:	EQU	$+0

;****************5***************************************************
;  LOADERCODE v5.7 (.COM flat binary files)
;*******************************************************************
LOADERCODE:
	CLR	R15
	ORI	R15,0007H
	LST	R15

	CLR	R0
	LI	R3,0500H
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JNE	LDRDET
	B	@LDRRUN_F
LDRDET:	MOV	R1,R1
	JLT	LDRDET_ERR
	JMP	LDRRAW
LDRDET_ERR:
	B	@LDRERR

LDRRAW:
	LI	R3,0500H
	MOV	@LADDR,R4
LDRRAW1:	MOV	*R3+,*R4+
	CI	R3,0700H
	JL	LDRRAW1
	MOV	@LADDR,R3
	AI	R3,BYTSEC
	MOV	R3,@FREEMEM

LDRRAWS:	DECT	SP
	MOV	R3,*SP
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	MOV	*SP+,R3
	CI	R1,-1
	JNE	LDRRAWS1
	B	@LDRRUN_F
LDRRAWS1:
	MOV	R1,R1
	JLT	LDRRAWS_ERR
	AI	R3,BYTSEC
	MOV	R3,@FREEMEM
	JMP	LDRRAWS
LDRRAWS_ERR:
	B	@LDRERR

LDRRUN_F:
	MOV	@LOAD_ONLY,R0
	JEQ	LDRRUN_F1
	B	@LDRRUN_LOAD
LDRRUN_F1:
	PSEL_DIS
	CLR	R15
	ORI	R15,0007H

	LI	R12,MAP_WIN_BASE+(SEGC*2)
	LI	R0,APAGE
	SLA	R0,8
	LDCR	R0,BYTEWIDE
	INCT	R12
	LDCR	R0,BYTEWIDE

	LI	R0,0E000H
	MOV	R0,@MEMLIMIT
	MOV	@LADDR,R8
	B	@LGATE

LDRERR:	MESG	@TXT_LDRERR
	B	@RETURN

TXT_LDRERR:	TEXT	'--Loader read error'
		BYTE	0DH,0AH,0
		EVEN
TXT_LOADED:	TEXT	'Loaded'
		BYTE	0DH,0AH,0
		EVEN

END_LOADER:	EQU	$+0

LDRRUN:	CALL	@DUMP_EXE_TRACE
	CALL	@SET_MEM_EXE
	MOV	@LOAD_ONLY,R0
	JNE	LDRRUN_LOAD
	CLR	R15
	ORI	R15,0007H
	LST	R15
	PSEL_EN
	B	*R8

LDRRUN_LOAD:
	PSEL_DIS
	CLR	R0
	MOV	R0,@LOAD_ONLY
	MESG	@TXT_LOADED
	B	@NEXTCMD

SET_MEM_EXE:
	LI	R1,DBG_LOG
	MOV	@DBG_COUNT,R2
	CI	R2,144
	JLE	SME_CLOK
	LI	R2,144
SME_CLOK:
	LI	R3,01000H
	LI	R6,0C000H
SME_LOOP:
	MOV	R2,R2
	JEQ	SME_DONE
	MOV	*R1+,R4
	MOV	*R1+,R5
	MOV	*R1+,R0
	INCT	R1
	MOV	R4,R4
	JNE	SME_PAGED
	A	R5,R0
	C	R0,R3
	JLE	SME_NEXT
	MOV	R0,R3
	JMP	SME_NEXT
SME_PAGED:
	MOV	R5,R0
	ANDI	R0,0F000H
	C	R0,R6
	JHE	SME_NEXT
	MOV	R0,R6
SME_NEXT:
	DEC	R2
	JMP	SME_LOOP
SME_DONE:
	MOV	R3,@FREEMEM
	MOV	R6,@MEMLIMIT
	RET

DUMP_EXE_TRACE:
	MOV	@DBG_ON,R0
	JNE	DMP_EXE_GO
	RET
DMP_EXE_GO:
	MOV	R8,@DBG_SAVE8
	LI	R0,DBG_LOG
	MOV	R0,@DBG_DPTR
	MOV	@DBG_COUNT,@DBG_DCOUNT
	MOV	@DBG_DCOUNT,R0
	CI	R0,144
	JLE	DMP_EXE_CLOK
	LI	R0,144
	MOV	R0,@DBG_DCOUNT
DMP_EXE_CLOK:
DMP_EXE_LOOP:
	MOV	@DBG_DCOUNT,R0
	JEQ	DMP_EXE_DONE
	MOV	@DBG_DPTR,R4
	MOV	*R4+,@DBG_V0
	MOV	*R4+,@DBG_V1
	MOV	*R4+,@DBG_V2
	MOV	*R4+,@DBG_V3
	MOV	R4,@DBG_DPTR

	MESG	@DBG_OB
	MOV	@DBG_V0,R0
	WHEX	R0
	MESG	@DBG_SP
	MOV	@DBG_V1,R0
	WHEX	R0
	MESG	@DBG_SP
	MOV	@DBG_V2,R0
	WHEX	R0
	MESG	@DBG_SP
	MOV	@DBG_V3,R0
	WHEX	R0
	MESG	@DBG_CB

	DEC	@DBG_DCOUNT
	JMP	DMP_EXE_LOOP
DMP_EXE_DONE:
	MOV	@DBG_SAVE8,R8
	RET

DBG_SWSCAN:
	CLR	R0
	MOV	R0,@DBG_ON
	LI	R4,CMDLINE
DBGS1:	MOVB	*R4,R1
	JEQ	DBGS9
	CB	R1,@CR
	JEQ	DBGS9
	CB	R1,@SPACE
	JNE	DBGS2
	CB	@1(R4),@SWITCH
	JNE	DBGS2
	CB	@2(R4),@DBGCHR
	JNE	DBGS2
	MOVB	@3(R4),R1
	JEQ	DBGS3
	CB	R1,@CR
	JEQ	DBGS3
	CB	R1,@SPACE
	JEQ	DBGS3
DBGS2:	INC	R4
	JMP	DBGS1
DBGS3:	SETO	R0
	MOV	R0,@DBG_ON
	MOV	R4,R5
	AI	R4,3
DBGS4:	MOVB	*R4+,*R5+
	JNE	DBGS4
	LI	R0,3
	S	R0,@CMDL_SIZE
DBGS9:	RET

DBGCHR	BYTE	'D'
	EVEN

LSRC:
	PSEL_EN
	B	*R8
LEND:

RSRC:
	PSEL_DIS
	B	@RETURN
REND:

BSRC:
	PSEL_DIS
	CALL	@BDOS
	PSEL_EN
	RET
BEND:

;*******************************************************************
;	RETURN - program exit
;*******************************************************************
RETURN:
	LI	R12,MAP_WIN_BASE+(SEGC*2)
	CLR	R0
	LDCR	R0,BYTEWIDE
	INCT	R12
	LDCR	R0,BYTEWIDE
	BL	@MAP_INIT
	LI	R0,TPA
	MOV	R0,@FREEMEM
	LI	R0,SHELL
	MOV	R0,@MEMLIMIT
	MOVB	R1,@CMDLINE-2
	LWPI	WORKSP
	LI	SP,STACKP
	CLR	R15
	MOVB	@CMDLINE-2,R1
	SRA	R1,8
	CI	R1,-1
	JNE	NEXTCMD
	CLR	R1
	MOVB	R1,@CMDLINE-2
	MOV	R1,R1
	JEQ	NEXTCMD
	B	@UNPROC

;****************5***************************************************
;	NEXTCMD / PROMPT (with [DIR]% display)
;*******************************************************************
NEXTCMD	MOVB	@PROCSW,R1
	JEQ	PROMPT
	B	@PFETCH

PROMPT:
	LI	R4,CURDIR
	CB	*R4,@SPACE
	JEQ	PR_STD

	LI	R3,05B00H		; '['
	CALL	@OUTCHAR

	LI	R4,CURDIR
	LI	R5,11
PR_DIR:	MOVB	*R4+,R3
	CB	R3,@SPACE
	JEQ	PR_BRK
	CALL	@OUTCHAR
	DEC	R5
	JNE	PR_DIR

PR_BRK:	LI	R3,05D00H		; ']'
	CALL	@OUTCHAR

PR_STD:	MOVB	@PROM,R3
	CALL	@OUTCHAR
	LI	R4,CMDLINE
	LI	R5,CLSZ

CINLOOP	MOV	@CONSOLE,R1
	CALL	@INCHAR
	CB	R1,@BS
	JEQ	RUBOUT
	CB	R1,@DEL
	JEQ	RUBOUT
	CB	R1,@CTLC
	JNE	STOWIT
	MOVB	@CR,R1
	MOVB	R1,@CMDLINE

STOWIT	MOV	R1,R0
	SRL	R0,8
	CI	R0,61H
	JL	STOWIT2
	CI	R0,7AH
	JH	STOWIT2
	AI	R0,-20H
	SWPB	R0
	MOVB	R0,*R4+
	JMP	STOWIT2+2
STOWIT2	MOVB	R1,*R4+
	DEC	R5
	JLE	CIOERR
	CB	R1,@SPACE
	JHE	ECHO
	CLR	R0
	MOVB	@CR,R1
	MOVB	R0,*R4
ECHO	MOV	R1,R3
	CALL	@OUTCHAR
	CLR	@SKIPSW
	CB	R1,@LF
	JEQ	GODOCMD
	JMP	CINLOOP
RUBOUT	CI	R5,CLSZ
	JHE	CINLOOP
	INC	R5
	DEC	R4
	DECT	SP
	MOV	R4,*SP
	LI	R4,RUBMSG
	CALL	@OUTSTR
	MOV	*SP+,R4
	JMP	CINLOOP
GODOCMD	LI	R0,CMDLINE
	S	R0,R4
	MOV	R4,@CMDL_SIZE
	B	@DOCMD
CIOERR	B	@LINERR

;****************5***************************************************
;	INTERNAL COMMANDS
;*******************************************************************
CMDCNT	EQU	7
ICLIST	TEXT	"DIR"
	BYTE	0
	WORD	DSKDIR
	TEXT	"SAVE"
	BYTE	0
	WORD	DSKSAVE
	TEXT	"ERA"
	BYTE	0
	WORD	ERAFILE
	TEXT	"TYPE"
	BYTE	0
	WORD	TYPEFILE
	TEXT	"LOAD"
	BYTE	0
	WORD	DOLOAD
	TEXT	"MKDIR"
	BYTE	0
	WORD	DOMKDIR
	TEXT	"CHDIR"
	BYTE	0
	WORD	DOCHDIR
	EVEN

BUFPNT	WORD	0
RECCNT	WORD	0
LOAD_ONLY:	WORD	0
SADDR	WORD	0
SWITCH	BYTE	'-'
	EVEN

ICMD	LI	R1,ICLIST
	LI	R4,FCB
	LI	R5,CMDCNT
ICMD0	CB	*R4+,*R1+
	JEQ	ICMD0
	DEC	R1
	DEC	R4
	CB	*R4,@SPACE
	JH	ICMD1
	MOVB	*R1,R0
	JNE	ICMD1
	INC	R1
	MOVB	*R1+,R2
	SWPB	R2
	MOVB	*R1+,R2
	SWPB	R2
	MOV	*SP+,R0
	B	*R2
ICMD1	DEC	R5
	JEQ	ICMDE
ICMD2	MOVB	*R1+,R0
	JNE	ICMD2
	INCT	R1
	LI	R4,FCB
	JMP	ICMD0
ICMDE	RET

;*******************************************************************
;	DIR
;*******************************************************************
BAR	TEXT	' : '
	BYTE	0
CRLF	BYTE	0DH,0AH,0
SEP	TEXT	'  '
	BYTE	0
MNOFILE	TEXT	'NO FILES'
	BYTE	0DH,0AH,0
	EVEN
DIRCOLS	EQU	4
CCOUNT	WORD	0
	EVEN

DSKDIR:	CLR	R0
	MOV	R0,@CCOUNT

	; --- FULLY INITIALIZE FCB FOR SAFE DIRECTORY SEARCH ---
	LI	R4,FCB
	CLR	@CRN(R4)		; Clear Current Record Number
	CLR	@CBN(R4)		; Clear Current Block Number

	; Clear bytes 12 through 35 of FCB to prevent stale pointers
	LI	R2,12
	LI	R5,FCB+12
DSK_CLR: CLR	*R5+
	DECT	R2
	JNE	DSK_CLR

	; --- TELL BDOS TO USE THE ACTIVE FOLDER ---
	MOVB	@SPACE,@FCB+18		; Blank target byte = Use CFLD

	; Populate filename fields (bytes 0-10) with '?' wildcards
	LI	R1,'?'*256
	LI	R0,NAMSIZ
	LI	R8,FCB
	MOV	R8,R2
DSKDIR0	MOVB	R1,*R2+
	DEC	R0
	JNE	DSKDIR0

	; Note: BDOS automatically filters SEARCH1 using its internal
	; active CFLD context set by FCHDIR. By clearing the FCB cruft,
	; SEARCH1 can now read Sector 0 of the directory without interference.
	; -----------------------------------------------------

	LI	R2,SEARCH1
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	NOFILE
	CALL	@PNAME
DSKDIR1	LI	R2,SEARCH2
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	DIREXIT
	CALL	@PNAME
	JMP	DSKDIR1

PNAME	MOV	R3,R1
	LI	R0,NAMSIZ
PNAME2	DECT	SP
	MOV	R0,*SP
	MOVB	*R1+,R3
	SWPB	R3
	DECT	SP
	MOV	R1,*SP
	LI	R2,COUT
	CALL	@BDOS
	MOV	*SP+,R1
	MOV	*SP+,R0
	DEC	R0
	JNE	PNAME2
	INC	@CCOUNT
	MOV	@CCOUNT,R0
	CI	R0,DIRCOLS
	JLT	PNAMESP
	CLR	R0
	MOV	R0,@CCOUNT
	MESG	@CRLF
	JMP	PNAME3
PNAMESP	MESG	@SEP
PNAME3	RET

DIREXIT	MESG	@CRLF
	CLR	R1
	B	@RETURN
NOFILE	MESG	@MNOFILE
	CLR	R1
	B	@RETURN

;****************5***************************************************
;	SAVE
;*******************************************************************
CMDPTR	EQU	0A0H
PARSERR	B	@PARSMSG

DSKSAVE:	CLR	@BUFPNT
	CLR	@RECCNT
	LI	R3,TPA
	MOV	R3,@SADDR
	LI	R3,CMDLINE
START00	CB	*R3+,@SPACE
	JH	START00
	DEC	R3
START02	CB	*R3,@CR
	JEQ	PARSERR
	CB	*R3+,@SPACE
	JLE	START02
	DEC	R3
	MOV	R3,@BUFPNT
	CALL	@ATOD
	MOV	R1,R1
	JEQ	PARSERR
	MOV	R1,@RECCNT
	MOV	@BUFPNT,R3
PREPARSE	CB	*R3,@CR
	JEQ	PARSERR
	CB	*R3+,@SPACE
	JLE	PREPARSE
	DEC	R3
	CALL	@PARSENAME
NAM2	CB	*R3+,@SPACE
	JEQ	NAM2
	DEC	R3
	CB	*R3,@CR
	JEQ	NAMSRCH
	CB	*R3+,@SWITCH
	JNE	PARSERR
	MOV	R3,@BUFPNT
	CALL	@CATOH
	MOV	R1,R1
	JEQ	PARSERR
	MOV	R1,@SADDR
NAMSRCH	LI	R2,SEARCH1
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	NAM5
NAM3	LI	R2,ERAFIL
	LI	R3,FCB
	CALL	@BDOS
NAM5	LI	R2,MAKFIL
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JHE	SKMK1
	B	@MKERR
SKMK1:
	LI	R4,FCB
	MOV	@SADDR,R3
	MOV	R3,@FLA(R4)
	CLR	@CRN(R4)
WRDATA	DECT	SP
	MOV	R3,*SP
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,WRSEQ
	LI	R3,FCB
	CALL	@BDOS
	MOV	*SP+,R3
	MOV	R1,R1
	JHE	SKWR1
	B	@WRITERR
SKWR1:
	C	R3,@MEMLIMIT
	JL	SKLG1
	B	@LARGERR
SKLG1:
	AI	R3,BYTSEC
	DEC	@RECCNT
	JNE	WRDATA
WRDATAC	LI	R2,FCLOSE
	LI	R3,FCB
	CALL	@BDOS
EXIT	CLR	R1
	B	@RETURN

;****************5***************************************************
;	ERASE
;*******************************************************************
ERAPERR	B	@PARSMSG

ERAFILE	CLR	@RECCNT
	CLR	@BUFPNT
	LI	R3,TPA
	MOV	R3,@SADDR
	LI	R3,CMDLINE
ERA0	CB	*R3+,@SPACE
	JH	ERA0
	DEC	R3
ERA01	CB	*R3,@CR
	JEQ	ERAPERR
	CB	*R3+,@SPACE
	JLE	ERA01
	DEC	R3
	CALL	@PARSENAME
ERA4	LI	R2,SEARCH1
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	ERAE
	LI	R2,ERAFIL
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JHE	SKMK2
	B	@MKERR2
SKMK2:
ERAE	CLR	R1
	B	@RETURN


;****************5***************************************************
;	MKDIR - Make Directory
;*******************************************************************
DOMKDIR:
	LI	R3,CMDLINE
MKSK1	CB	*R3+,@SPACE
	JH	MKSK1
	DEC	R3
MKSK2	CB	*R3,@CR
	JEQ	MKERR_SYN
	CB	*R3+,@SPACE
	JLE	MKSK2
	DEC	R3
	CALL	@PARSENAME
	LI	R2,FMKDIR
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	MKERR_SYS
	B	@RETURN
MKERR_SYN:
	B	@PARSMSG
MKERR_SYS:
	MESG	@MKERRMSG
	B	@RETURN

;****************5***************************************************
;	CHDIR - Change Directory
;*******************************************************************
DOCHDIR:
	LI	R3,CMDLINE
CHSK1	CB	*R3+,@SPACE
	JH	CHSK1
	DEC	R3
CHSK2	CB	*R3,@CR
	JEQ	CHROOT
	CB	*R3+,@SPACE
	JLE	CHSK2
	DEC	R3
	CALL	@PARSENAME
	JMP	CHDOIT
CHROOT:
	LI	R4,FCB
	LI	R2,11
CHPAD:	MOVB	@SPACE,*R4+
	DEC	R2
	JNE	CHPAD
CHDOIT:
	LI	R2,FCHDIR
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	CHERR_SYS

	LI	R4,CURDIR
	LI	R5,FCB
	LI	R2,11
CHCPY:	MOVB	*R5+,*R4+
	DEC	R2
	JNE	CHCPY
	B	@RETURN

CHERR_SYS:
	MESG	@CHERRMSG
	B	@RETURN

MKERRMSG TEXT	'--Directory creation failed'
	 BYTE	0DH, 0AH, 0
	 EVEN
CHERRMSG TEXT	'--Directory not found'
	 BYTE	0DH, 0AH, 0
	 EVEN
CURDIR	 TEXT	'           '		; 11 spaces = Root
	 EVEN

;****************5***************************************************
;	Error handlers
;*******************************************************************
WRITERR	MESG	@ERRMSG4
	JMP	MKERR2
MKERR	B	@MONITOR
	MESG	@ERRMSG3
	JMP	MKERR2
CLOSERR	MESG	@ERRMSG1
	JMP	MKERR2
PARSMSG	MESG	@ERRMSG2
	B	@NEXTCMD
LARGERR	MESG	@ERRMSG5
	JMP	MKERR2
MKERR2	LI	R2,FCLOSE
	LI	R3,FCB
	CALL	@BDOS
	B	@RETURN

;****************5***************************************************
;	DOLOAD - load overlay into paged memory without executing
;*******************************************************************
DOLOAD:
	LI	R3,CMDLINE
DLSK1	CB	*R3+,@SPACE
	JH	DLSK1
	DEC	R3
DLSK2	CB	*R3,@CR
	JNE	DLSK_E
	B	@DLERR
DLSK_E	CB	*R3+,@SPACE
	JLE	DLSK2
	DEC	R3
	CALL	@PARSENAME

	LI	R4,FCB
	CLR	@CRN(R4)
	LI	R2,FOPEN
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JHE	DLSK_F
	B	@DLERR
DLSK_F

	LI	R3,STAGING
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JNE	DLSK_G
	B	@DLERR
DLSK_G

	LI	R6,STAGING
	LI	R8,STAGING+512

DLBLK:
	MOV	R6,R7
	MOV	*R6+,R5
	MOV	*R6+,R4
	MOV	*R6+,R2
	MOV	*R6+,R3

	MESG	@DBG_BLK
	MOV	R4,R0
	WHEX	R0
	MESG	@DBG_SEP
	MOV	R2,R0
	WHEX	R0
	MESG	@DBG_SEP
	MOV	R3,R0
	WHEX	R0
	MESG	@DBG_NL

	MOV	R4,R0
	JEQ	DLCPY_S
	MOV	R2,R9
	SRL	R9,12
	BL	@MAP_SET

DLCPY_S:	PSEL_EN
	SRL	R3,1
DLCPY:
	MOV	*R6+,*R2+
	DEC	R3
	JEQ	DLDONE_B
	C	R6,R8
	JL	DLCPY

	PSEL_DIS
	DECT	SP
	MOV	R7,*SP
	DECT	SP
	MOV	R5,*SP
	DECT	SP
	MOV	R3,*SP
	DECT	SP
	MOV	R2,*SP
	LI	R3,STAGING
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	MOV	*SP+,R2
	MOV	*SP+,R3
	MOV	*SP+,R5
	MOV	*SP+,R7
	CI	R1,-1
	JEQ	DLDONE_B
	PSEL_EN
	LI	R6,STAGING
	LI	R8,STAGING+512
	JMP	DLCPY

DLDONE_B:
	PSEL_DIS
	MOV	R5,R5
	JEQ	DLDONE
	A	R5,R7
	MOV	R7,R6
	C	R6,R8
	JL	DLBLK
	S	R8,R6
	DECT	SP
	MOV	R5,*SP
	DECT	SP
	MOV	R6,*SP
	LI	R3,STAGING
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	MOV	*SP+,R6
	MOV	*SP+,R5
	LI	R8,STAGING+512
	AI	R6,STAGING
	JMP	DLBLK

DLDONE:
	MESG	@DLTXT_OK
	B	@NEXTCMD

DLERR	MESG	@DLTXT_ERR
	B	@NEXTCMD

DLTXT_OK	TEXT	'Loaded as overlay '
	BYTE	0
	EVEN
DLTXT_CRLF	BYTE	0DH,0AH,0
	EVEN
DLTXT_ERR	TEXT	'--Load error'
	BYTE	0DH,0AH,0
	EVEN

TYPERR	MESG	@MNOFILE
	B	@NEXTCMD

TYPEFILE:
TYSK2	MOVB	*R3,R0
	JEQ	TYPARSE_ERR
	CB	R0,@CR
	JEQ	TYPARSE_ERR
	CB	*R3+,@SPACE
	JLE	TYSK2
	DEC	R3
	CALL	@PARSENAME
	JMP	TYPE_OPEN

TYPARSE_ERR:
	B	@PARSMSG

TYPE_OPEN:
	LI	R4,FCB
	CLR	@CRN(R4)
	LI	R2,FOPEN
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	TYPERR

TYSEC	LI	R3,STAGING
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JEQ	TYDONE

	LI	R6,STAGING
	LI	R7,BLKSIZ
TYCH	MOVB	*R6+,R3
	CB	R3,@CTLZ
	JEQ	TYDONE
	SWPB	R3
	DECT	SP
	MOV	R6,*SP
	DECT	SP
	MOV	R7,*SP
	LI	R2,COUT
	CALL	@BDOS
	MOV	*SP+,R7
	MOV	*SP+,R6
	DEC	R7
	JNE	TYCH
	JMP	TYSEC

TYDONE	LI	R2,FCLOSE
	LI	R3,FCB
	CALL	@BDOS
	MESG	@CRLF
	CLR	R1
	B	@RETURN

;****************5***************************************************
;	ASCII conversion utilities
;*******************************************************************
ATOD	CLR	R3
	LI	R8,10
ATOD00	MOV	@BUFPNT,R0
	MOVB	*R0,R2
	SRL	R2,8
	AI	R2,-'0'
	JLT	ATOD03
	CI	R2,10
	JLT	ATOD04
ATOD03	MOV	R3,R1
	RET
ATOD04	MOV	R2,R0
	MOV	R3,R2
	MPY	R8,R2
	A	R0,R3
	INC	@BUFPNT
	JMP	ATOD00

CATOH	CLR	R2
LOOP	MOV	@BUFPNT,R0
	CLR	R1
	MOVB	*R0,R1
	CI	R1,'0'*256
	JL	NOTHEX
	CI	R1,'9'*256
	JLE	GOTONE
	CI	R1,'A'*256
	JL	NOTHEX
	CI	R1,'F'*256
	JH	NOTHEX
	AI	R1,0900H
GOTONE	SLA	R1,4
	SRL	R1,12
	SLA	R2,4
	A	R1,R2
	INC	@BUFPNT
	JMP	LOOP
NOTHEX	MOV	R2,R1
	RET

;****************5***************************************************
;	Error messages
;*******************************************************************
ERRMSG1	TEXT	'--Close error'
	BYTE	0DH,0AH,0
ERRMSG2	TEXT	'--Parse error'
	BYTE	0DH,0AH,0
ERRMSG3	TEXT	'--Make error'
	BYTE	0DH,0AH,0
ERRMSG4	TEXT	'--Write error'
	BYTE	0DH,0AH,0
ERRMSG5	TEXT	'--File too large error'
	BYTE	0DH,0AH,0
	EVEN

;****************5***************************************************
;	PROCEDURE processing
;*******************************************************************
PFETCH	LI	R4,CLSZ-1
	MOV	R4,@CMDBYTES
	LI	R4,CMDLINE
	MOV	R4,@CMDADDR
	CLR	@SUBFLAG
PLOOP	MOV	@MCNT,R4
	JNE	BUFMOVE
	MOV	@PRECS,R4
	JEQ	PROCERR1

	; --- NO MORE FCB SWAPPING! READ DIRECTLY FROM PROC_FCB ---
	LI	R3,DEFDRV
	LI	R2,SELDSK
	CALL	@BDOS
	LI	R3,PRBUF
	LI	R2,SETDMA
	CALL	@BDOS

	LI	R3,PROC_FCB		; <--- Point BDOS straight to the Procedure FCB
	LI	R2,RDSEQ
	CALL	@BDOS
	MOV	R1,R1
	JLT	PROCERR0

	LI	R1,BLKSIZ
	MOV	R1,@MCNT
	LI	R4,PRBUF
	MOV	R4,@MADDR
	DEC	@PRECS
	JMP	BUFMOVE
PROCERR0	B	@SHELLERR
PROCERR1	B	@UNPROC

BUFMOVE	MOV	@MADDR,R4
	MOVB	*R4+,R1
	MOV	R4,@MADDR
	DEC	@MCNT
	DECT	SP
	MOV	R1,*SP
	MOV	@SUBFLAG,R0
	JNE	PARMSUB
	MOV	*SP+,R1
	CB	R1,@SUBMARK
	JNE	BUFMOV2
	SETO	@SUBFLAG
	JMP	PLOOP
BUFMOV2	CB	R1,@EOF
	JEQ	BUFMOV4
	CB	R1,@PAD
	JEQ	BUFMOV4
	CB	R1,@CPMEOF
	JEQ	BUFMOV4
BUFMOV3	CB	R1,@LF
	JEQ	PLOOP
BUFPUT	MOV	@CMDADDR,R4
	MOVB	R1,*R4
	CB	R1,@CR
	JNE	BUFPUT2
	INC	R4
	CLR	R1
	MOVB	R1,*R4
	JMP	PEOL
BUFPUT2	INC	R4
	MOV	R4,@CMDADDR
	DEC	@CMDBYTES
	JEQ	MOVERR
	JMP	PLOOP
BUFMOV4	B	@UNPROC
MOVERR	B	@LINERR

PARMSUB	CLR	@SUBFLAG
	MOV	*SP+,R1
	DECT	SP
	MOV	R1,*SP
	SRL	R1,8
	AI	R1,0FFE0H
	JLT	NOSUB
	CI	R1,10
	JGT	NOSUB
	MOV	R1,R2
	MOV	*SP+,R1
	LI	R4,PPTRS
SUBLOOP	MOV	*R4,R3
	JEQ	NULLPARM
	DEC	R2
	JGT	SUBLOOP
SUBLOOP2	MOVB	*R3,R1
	CB	@SPACE,R1
	JLT	SUBDONE
	INC	R3
	MOV	@CMDADDR,R4
	MOVB	R1,*R4+
	MOV	R4,@CMDADDR
	DEC	@CMDBYTES
	JEQ	LINERR
	JMP	SUBLOOP2
SUBDONE	B	@PLOOP
NOSUB	MOV	*SP+,R1
	JMP	BUFMOV2
NULLPARM	LI	R1,0A00H
	JMP	BUFMOV3

PEOL	MOVB	@CMDLINE,R1
	CB	@COMT,R1
	JEQ	BPFETCH
	CB	@NOTE,R1
	JEQ	VIEW
	MOV	@VSW,R1
	JEQ	CKNSW
VIEW	LI	R4,CMDLINE
	CALL	@OUTSTR
CKNSW	MOV	@NSW,R1
	JNE	BPFETCH
	MOVB	@CMDLINE,R1
	CB	@NOTE,R1
	JNE	BTDOCMD
	LI	R4,CMDLINE
	INC	R4
	CB	*R4,@NOTE
	JNE	BPFETCH
WAIT	LI	R4,WAITMSG
	CALL	@OUTSTR
	CLR	R1
	CALL	@CIN
	PUSH	R1
	MOVB	@CR,R3
	CALL	@OUTCHAR
	POP	R1
	CB	R1,@CR
	JEQ	BPFETCH
	CB	R1,@CTLC
	JEQ	UNPROC
	CB	R1,@CTLS
	JNE	WAIT
	SETO	@SKIPSW
BPFETCH	B	@PFETCH
BTDOCMD	B	@DOCMD

;****************5***************************************************
;	Error output
;*******************************************************************
CMDERR	LI	R4,CMDLINE
	JMP	ERROUT
LINERR	MOV	@CR,R2
	LI	R4,LINEMSG
	JMP	ERROUT
PARMERR	LI	R4,PARMSG
	JMP	ERROUT
SHELLERR	LI	R4,SHELLMSG
	JMP	ERROUT
HARDERR	LI	R4,HARDMSG
	JMP	ERROUT
NULLERR	LI	R4,NULLMSG
	JMP	ERROUT
NESTERR	LI	R4,NESTMSG
	JMP	ERROUT
ERROUT:
	MESG	@QUESTMSG
	MESG	*R4
	MESG	@CRLF

UNPROC	CLR	@PROCSW
	LI	R4,CHKSYS
	INCT	R4
	MOVB	@SYSFILE,*R4
	B	@RETURN

DOPROC	MOV	@PROCSW,R1
	JNE	NESTERR
	SETO	R1
	MOV	R1,@PROCSW

	; --- ONE-TIME INITIALIZATION OF PROC_FCB ---
	LI	R4,FCB
	CLR	@CRN(R4)
	LI	R3,FCB
	LI	R4,PROC_FCB		; <--- Copy to our new dedicated engine FCB
	LI	R2,FCBSIZ
	CALL	@BMOVE

	MOV	@MFSZ,@PRECS
	CLR	R4
	MOV	R4,@MCNT
	CLR	@VSW
	CLR	@NSW
	LI	R4,PPTRS
	MOV	R4,@PPADDR
	LI	R3,PBUF
	LI	R4,CMDLINE
	LI	R2,10
	CLR	R0
PARSLOOP	CLR	R1
	MOVB	*R4+,R1
	CI	R1,2D00H
	JNE	PARS1
	MOV	R0,R0
	JNE	PARS0B
	INC	R4
	MOVB	*R4,R1
	DEC	R4
	CI	R1,2000H
	JH	PARS0B
	MOVB	*R4,R1
	CI	R1,5600H
	JNE	PARS0A
	MOV	R1,@VSW
PARS0	INC	R4
	JMP	PARSLOOP
PARS0A	CI	R1,4E00H
	JNE	PARS0B
	LI	R1,2D00H
	MOV	R1,@NSW
	JMP	PARS0
PARS0B	LI	R1,2D00H
PARS1	MOVB	R1,*R3+
	CI	R1,0D00H
	JEQ	PARSEND
	CI	R1,2000H
	JH	PARS2
	MOV	R0,R0
	JEQ	PARSLOOP
	CLR	R0
	JMP	PARSLOOP
PARS2	MOV	R0,R0
	JNE	PARSLOOP
	SETO	R0
	DEC	R2
	JLT	PARMERR
	DECT	SP
	MOV	R4,*SP
	DECT	SP
	MOV	R3,*SP
	DEC	R3
	MOVB	*R4,R1
	CI	R1,2000H
	JGT	PARS3
	CB	*R3,@NULPARM
	JNE	PARS3
	LI	R1,2000H
	MOVB	R1,*R3
PARS3	MOV	@PPADDR,R4
	MOV	R3,*R4+
	MOV	R4,@PPADDR
	MOV	*SP+,R3
	MOV	*SP+,R4
	JMP	PARSLOOP
PARSEND	CLR	@PPADDR
	B	@PFETCH

BMOVE	MOVB	*R3+,*R4+
	DEC	R2
	JNE	BMOVE
	RET

;****************5***************************************************
;	Console I/O
;*******************************************************************
INCHAR	LI	R2,CIN
	CALL	@BDOS
	SWPB	R1
	RET

OUTCHAR	DECT	SP
	MOV	R3,*SP
	SWPB	R3
	LI	R2,COUT
	CALL	@BDOS
	MOV	*SP+,R3
	CB	R3,@CR
	JNE	OUT0
	MOVB	@LF,R3
	SWPB	R3
	LI	R2,COUT
	CALL	@BDOS
	LI	R3,0D0AH
OUT0	RET

OUTSTR	MOVB	*R4,R3
	JEQ	STR0
	INC	R4
	CALL	@OUTCHAR
	JMP	OUTSTR
STR0	RET

;****************5***************************************************
;	Variables
;*******************************************************************
DBG_PTR		WORD	0
DBG_COUNT	WORD	0
DBG_DPTR	WORD	0
DBG_CHKADDR	WORD	0
DBG_DCOUNT	WORD	0
DBG_SAVE8	WORD	0
DBG_V0		WORD	0
DBG_V1		WORD	0
DBG_V2		WORD	0
DBG_V3		WORD	0
DBG_ON		WORD	0
FB_FLAG		WORD	0
DBG_LOG		BSS	1152
		EVEN
CMDADDR		WORD	0
CMDBYTES	WORD	0
DOSV		WORD	0
HDERRV		WORD	0
DOSERRV		WORD	0
PROCSW		WORD	0
SKIPSW		WORD	0
VSW		WORD	0
NSW		WORD	0
SUBFLAG		WORD	0
LADDR		WORD	0

VMENTRY		WORD	0
CMDLINE2	BYTE	0DH,00
		EVEN
		BSS	CLSZ
		EVEN

		EVEN
PROC_FCB	BSS	FCBSIZ
		EVEN
MFTY		WORD	0
EXTWALK		WORD	0
MFSZ		WORD	0
PRECS		WORD	0
PRBUF		BSS	BLKSIZ
		EVEN
		BSS	8
MCNT		WORD	0
MADDR		WORD	0

;****************5***************************************************
;	Messages
;*******************************************************************
DBG_OB	TEXT	'['
	BYTE	0
	EVEN
DBG_SP	TEXT	' '
	BYTE	0
	EVEN
DBG_CB	TEXT	']'
	BYTE	0DH,0AH,0
	EVEN
DBG_BLK	TEXT	'BLK PG:'
	BYTE	0
	EVEN
DBG_SEP	TEXT	' '
	BYTE	0
	EVEN
DBG_NL	BYTE	0DH,0AH,0
	EVEN
	EVEN

SINON	BYTE	0DH,0AH
	TEXT	'Shell Version 6.3'
	BYTE	0DH,0AH
	TEXT	'TMS99105 SBC V4 - Paged Memory'
	BYTE	0DH,0AH
NULLMSG	BYTE	0
	EVEN

QUESTMSG	TEXT	"?"
		BYTE	0
		EVEN
NESTMSG		TEXT	"Program name expected:"
		BYTE	0DH,00
		EVEN
SHELLMSG	TEXT	"Shell error:"
		BYTE	0DH,00H
		EVEN
RUBMSG		BYTE	08H,20H,08H,0
		EVEN
PARMSG		TEXT	"Too many parameters:"
		BYTE	0DH,00
		EVEN
LINEMSG		TEXT	"Line too long:"
		BYTE	0DH,00
		EVEN
HARDMSG		TEXT	"Hard disc error"
		BYTE	0DH,00
		EVEN
WAITMSG		TEXT	"--waiting..."
		BYTE	0
		EVEN

;****************5***************************************************
;	MAP_INIT - clear all 16 map registers to page 0
;*******************************************************************
MAP_INIT	CLR	R15
	LST	R15
	LI	R12,MAP_WIN_BASE
	CLR	R0
	LI	R1,NUM_MAP_ENTRIES
MAPI_L:	LDCR	R0,BYTEWIDE
	INCT	R12
	DEC	R1
	JNE	MAPI_L
	RT

;****************5***************************************************
;	MAP_SET - program one 6116 map register
;*******************************************************************
MAP_SET:
	LI	R12,MAP_WIN_BASE
	SLA	R9,1
	A	R9,R12
	SLA	R0,8
	LDCR	R0,BYTEWIDE
	RT

PPTRS	BSS	22
PBUF	BSS	64
PPADDR	WORD	0

	END
