;===================================================================
; TYPE.A99 - shell internal command TYPE                  (shell 6.5)
;
; Assembled on its own at AORG >D000 and loaded at cold start into
; its own physical page of segment D (page 5).  Runs with PSEL on.
;
; Rules for every command page:
;   - exit by branching into the core - RETURN, NEXTCMD or an error
;     exit; never return, never call another command
;   - never execute PSEL_DIS, never remap segment D
;   - the BDOS is reached through the gate: CORE.INC equates BDOS to it,
;     so DECLS.INC must never declare BDOS
;   - the first instruction must be B @entry: LDCMDS checks for it
;   - anything up to 4096 bytes fits; the page is this command's alone
;===================================================================
	INCL	"C:DECLS.INC"	; registers, XOPs, EQUs (hand-maintained)
	INCL	"C:CORE.INC"	; core addresses (generated by MKCINC)
	AORG	0D000H
	B	@TYPEFILE		; entry: every command page starts here

;===================================================================
; TYPE - Display file contents with pagination
; Uses dedicated memory variables to survive BDOS register clobbering
;===================================================================
TYPERR	MESG	@MNOFILE
	B	@NEXTCMD

TYPEFILE:
TYSK2	MOVB	*R3,R0
	JEQ	TYPARSE_ERR
	CB	R0,@CR
	JEQ	TYPARSE_ERR
	CB	*R3+,@SPACE
	JLE	TYSK2
	DEC	R3
	CALL	@PARSENAME
	JMP	TYPE_OPEN

TYPARSE_ERR:
	B	@PARSMSG

; --- Safe Memory Variables ---
TYLCNT	WORD	0			; Line Counter
TYPFLG	WORD	0			; Pagination Flag (0 = pause, -1 = vomit)
ESCCHR	BYTE	1BH			; Escape Key ASCII
	EVEN

TYPE_OPEN:
	LI	R4,FCB
	CLR	@CRN(R4)		; Reset record cursor
	LI	R2,FOPEN
	LI	R3,FCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	TYPERR

	CLR	@TYLCNT			; Initialize memory line counter to 0
	CLR	@TYPFLG			; Initialize pagination flag to 0 (enabled)

TYSEC	LI	R3,STAGING
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,RDSEQ
	LI	R3,FCB
	CALL	@BDOS
	CI	R1,-1
	JNE	TYSEC_C
	B	@TYDONE			; Jump absolute to bridge long gap

TYSEC_C:
	LI	R6,STAGING
	LI	R7,BLKSIZ
TYCH	MOVB	*R6+,R3			; Fetch next character
	CB	R3,@CTLZ		; Check for CP/M EOF (^Z)
	JNE	TYCH_C
	B	@TYDONE			; Jump absolute to bridge long gap

TYCH_C:
	SWPB	R3			; Move char to low byte for BDOS
	DECT	SP
	MOV	R6,*SP
	DECT	SP
	MOV	R7,*SP
	LI	R2,COUT
	CALL	@BDOS			; Output the character
	MOV	*SP+,R7
	MOV	*SP+,R6

	SWPB	R3			; Restore char to high byte for comparison
	CB	R3,@LF			; Was it a Line Feed?
	JNE	TYNEXT			; If not, skip pagination logic

	MOV	@TYPFLG,R0		; Fetch "vomit" flag from memory
	JNE	TYNEXT			; If set, skip the pause check

	INC	@TYLCNT			; Increment memory line count
	MOV	@TYLCNT,R0
	CI	R0,PGLINE		; Reached the terminal page limit?
	JL	TYNEXT			; If not, continue output

	; --- Pagination Wait Loop ---
	DECT	SP
	MOV	R6,*SP			; Protect cursor across INCHAR
	DECT	SP
	MOV	R7,*SP			; Protect byte count across INCHAR
TYPAUSE	CALL	@TINCHAR			; Get keypress (returns in R1 high byte)
	CB	R1,@CR			; Did they press ENTER?
	JEQ	TYVOMIT
	CB	R1,@SPACE		; Did they press SPACE?
	JEQ	TYPAGE
	CB	R1,@CTLC		; Did they press CTRL-C?
	JEQ	TYABORT
	CB	R1,@ESCCHR		; Did they press ESC?
	JEQ	TYABORT
	JMP	TYPAUSE			; Loop until a valid key is pressed

TYVOMIT	SETO	R0
	MOV	R0,@TYPFLG		; Disable future pausing (-1)
TYPAGE	CLR	@TYLCNT			; Reset line counter for the next page
	MOV	*SP+,R7			; Restore registers
	MOV	*SP+,R6
	JMP	TYNEXT

TYABORT	MOV	*SP+,R7			; Clean up stack before aborting
	MOV	*SP+,R6
	B	@TYDONE			; Jump absolute to bridge long gap

TYNEXT	DEC	R7
	JNE	TYCH
	JMP	TYSEC

TYDONE	LI	R2,FCLOSE
	LI	R3,FCB
	CALL	@BDOS
	MESG	@CRLF
	CLR	R1
	B	@RETURN


; The core's INCHAR calls the BDOS directly, which this page must not
; do with PSEL on.  This one goes through the gate like every other
; BDOS call in a command page.
TINCHAR	LI	R2,CIN
	CALL	@BDOS
	SWPB	R1
	RET

	END
